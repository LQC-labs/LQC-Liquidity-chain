{
  "name": "@lqc-flow/dex-core",
  "version": "0.1.0",
  "private": true,
  "description": "LQC Flow DEX constant-product AMM MVP",
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "test": "npm run check:app && npm run test:contracts",
    "test:local": "npm test",
    "test:contracts": "npm run compile && mocha --timeout 30000 test/**/*.test.mjs",
    "gate:stage1": "node scripts/run-stage1-gate.mjs",
    "coverage:router-sdk": "node scripts/check-router-sdk-coverage.mjs",
    "preflight:testnet": "node scripts/preflight-testnet-deploy.mjs",
    "prepare:roles": "node scripts/prepare-operational-role-activation.mjs",
    "deploy:testnet": "npm run preflight:testnet && npm run compile && node scripts/deploy-testnet.mjs",
    "deploy:minimal:testnet": "npm run compile && node scripts/deploy-minimal-testnet.mjs",
    "prepare:verification": "npm run compile && node scripts/prepare-bscscan-verification.mjs",
    "prepare:role-activation": "node scripts/prepare-operational-role-activation.mjs",
    "verify:role-activation": "node scripts/verify-operational-role-activation.mjs",
    "verify:guardian-activation-tx": "node scripts/verify-guardian-activation-transaction.mjs",
    "validate:testnet": "node scripts/validate-bsc-testnet.mjs",
    "monitor:testnet": "node scripts/monitor-bsc-testnet.mjs",
    "smoke:testnet": "node scripts/smoke-test-bsc-routes.mjs",
    "configure:app": "node scripts/configure-app.mjs",
    "report:emergency-drill": "node scripts/emergency-drill-report.mjs",
    "package:review-evidence": "node scripts/build-review-evidence-package.mjs",
    "render:review-summary": "node scripts/render-review-evidence-markdown.mjs",
    "build:review-bundle": "node scripts/build-review-bundle.mjs",
    "check:app": "node --check app/config.js && node --check app/router-sdk.js && node --check app/i18n.js && node --check app/app.js"
  },
  "devDependencies": {
    "ethers": "^6.15.0",
    "ganache": "^7.9.2",
    "mocha": "^11.7.1",
    "solc": "0.8.30"
  }
}
