{
  "openapi": "3.1.0",
  "info": { "title": "LQC Read-Only Quote API", "version": "1.0.0" },
  "servers": [{ "url": "https://sandbox.invalid" }],
  "paths": {
    "/v1/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "responses": { "200": { "description": "Supported chain, schema versions, and safety features", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Capabilities" } } } } }
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": { "description": "Healthy or degraded", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } },
          "503": { "description": "Capacity exhausted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } }
        }
      }
    },
    "/v1/quote": {
      "post": {
        "operationId": "createQuote",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "X-LQC-Trace-ID", "in": "header", "required": false, "schema": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/QuoteRequest" } } } },
        "responses": {
          "200": { "description": "Verified quote proof", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/QuoteResponse" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "413": { "$ref": "#/components/responses/Error" },
          "415": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer" } },
    "schemas": {
      "QuoteRequest": {
        "type": "object", "additionalProperties": false,
        "x-lqc-request-hash-fields": ["version", "type", "chainId", "tokenIn", "tokenOut", "amountIn", "requestedAt", "expiresAt", "clientRequestId"],
        "required": ["version", "type", "chainId", "tokenIn", "tokenOut", "amountIn", "requestedAt", "expiresAt", "clientRequestId", "requestHash"],
        "properties": {
          "version": { "const": 1 }, "type": { "const": "LQC_MULTI_DEX_QUOTE_REQUEST" }, "chainId": { "const": 97 },
          "tokenIn": { "$ref": "#/components/schemas/Address" }, "tokenOut": { "$ref": "#/components/schemas/Address" },
          "amountIn": { "type": "string", "pattern": "^[1-9][0-9]*$", "maxLength": 78 }, "requestedAt": { "type": "integer", "minimum": 0 },
          "expiresAt": { "type": "integer", "minimum": 1 }, "clientRequestId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
          "requestHash": { "$ref": "#/components/schemas/Hash32" }
        }
      },
      "QuoteResponse": {
        "type": "object", "additionalProperties": false,
        "required": ["schemaVersion", "requestHash", "proof", "traceId"],
        "properties": { "schemaVersion": { "const": 1 }, "requestHash": { "$ref": "#/components/schemas/Hash32" },
          "proof": { "type": "object" }, "traceId": { "type": "string", "minLength": 1, "maxLength": 128 } }
      },
      "Capabilities": {
        "type": "object", "required": ["schemaVersion", "type", "supportedChains", "quoteRequestVersions", "quoteResponseVersions", "maxQuoteValidityMs", "features"],
        "properties": { "schemaVersion": { "const": 1 }, "type": { "const": "LQC_QUOTE_API_CAPABILITIES" },
          "supportedChains": { "type": "array", "items": { "type": "integer" } }, "quoteRequestVersions": { "type": "array", "items": { "type": "integer" } },
          "quoteResponseVersions": { "type": "array", "items": { "type": "integer" } }, "maxQuoteValidityMs": { "type": "integer", "maximum": 60000 },
          "features": { "type": "object" } }
      },
      "Health": {
        "type": "object", "additionalProperties": false, "required": ["schemaVersion", "type", "status", "checkedAt", "capacity", "policy", "metrics"],
        "properties": { "schemaVersion": { "const": 1 }, "type": { "const": "LQC_QUOTE_API_HEALTH" },
          "status": { "enum": ["healthy", "degraded", "busy"] }, "checkedAt": { "type": "integer" },
          "capacity": { "$ref": "#/components/schemas/HealthCapacity" }, "policy": { "$ref": "#/components/schemas/HealthPolicy" }, "metrics": { "$ref": "#/components/schemas/OperationalMetrics" } }
      },
      "HealthCapacity": {
        "type": "object", "additionalProperties": false, "required": ["inFlight", "maxInFlight", "completed", "maxCompletedEntries"],
        "properties": { "inFlight": { "$ref": "#/components/schemas/Counter" }, "maxInFlight": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "completed": { "$ref": "#/components/schemas/Counter" }, "maxCompletedEntries": { "type": "integer", "minimum": 1, "maximum": 100000 } }
      },
      "HealthPolicy": {
        "type": "object", "additionalProperties": false, "required": ["providerTimeoutMs", "rateLimit", "rateLimitWindowMs"],
        "properties": { "providerTimeoutMs": { "type": "integer", "minimum": 10, "maximum": 30000 },
          "rateLimit": { "type": "integer", "minimum": 1 }, "rateLimitWindowMs": { "type": "integer", "minimum": 1000 } }
      },
      "OperationalMetrics": {
        "type": "object", "additionalProperties": false,
        "required": ["requests", "authenticated", "unauthorized", "rateLimited", "succeeded", "replayed", "busy", "failed"],
        "properties": {
          "requests": { "$ref": "#/components/schemas/Counter" }, "authenticated": { "$ref": "#/components/schemas/Counter" },
          "unauthorized": { "$ref": "#/components/schemas/Counter" }, "rateLimited": { "$ref": "#/components/schemas/Counter" },
          "succeeded": { "$ref": "#/components/schemas/Counter" }, "replayed": { "$ref": "#/components/schemas/Counter" },
          "busy": { "$ref": "#/components/schemas/Counter" }, "failed": { "$ref": "#/components/schemas/Counter" }
        }
      },
      "Error": {
        "type": "object", "required": ["schemaVersion", "error", "traceId"],
        "properties": { "schemaVersion": { "const": 1 }, "error": { "type": "object", "required": ["code", "retryable"],
          "properties": { "code": { "type": "string" }, "retryable": { "type": "boolean" } } }, "traceId": { "type": "string" } }
      },
      "Address": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" },
      "Hash32": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
      "Counter": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
    },
    "responses": { "Error": { "description": "Stable error envelope", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } } }
  }
}
