interface VmLiq {function roll(uint256)external;function mockCall(address,bytes calldata,bytes calldata)external;function mockCallRevert(address,bytes calldata,bytes calldata)external;function clearMockedCalls()external;function etch(address,bytes calldata)external;function load(address,bytes32)external view returns(bytes32);}
contract LiquidationCallbackToken {
 mapping(address=>uint256)private balances;mapping(address=>mapping(address=>uint256))public allowance;address public target;address public custody;uint256 public market;bool public armed;
 function mint(address a,uint256 n)external{balances[a]+=n;}function approve(address a,uint256 n)external returns(bool){allowance[msg.sender][a]=n;return true;}function transfer(address a,uint256 n)external returns(bool){balances[msg.sender]-=n;balances[a]+=n;return true;}function transferFrom(address a,address b,uint256 n)external returns(bool){allowance[a][msg.sender]-=n;balances[a]-=n;balances[b]+=n;return true;}
 function arm(address e,address v,uint256 id,bool enabled)external{target=e;custody=v;market=id;armed=enabled;}
 function balanceOf(address a)external view returns(uint256){if(armed&&a==custody){(bool ok,bytes memory result)=target.staticcall(abi.encodeWithSignature('repayFundingDebt(uint256,uint256)',market,1));require(!ok&&result.length>=4&&bytes4(result)==Engine.ProtectedReentrancy.selector,'reentry lock missing');}return balances[a];}
}
