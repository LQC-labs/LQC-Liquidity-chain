pragma solidity ^0.8.24;
import {ProtectedFixture,Engine,Vault,Registry} from './ProtectedFixture.sol';
import {FuturesMathModule} from '../src/modules/FuturesMathModule.sol';
import {LiquidationCalculator} from '../src/modules/LiquidationCalculator.sol';
import {AdlCalculator} from '../src/modules/AdlCalculator.sol';
interface VmModules {function etch(address,bytes calldata)external;function mockCall(address,bytes calldata,bytes calldata)external;function mockCallRevert(address,bytes calldata,bytes calldata)external;function clearMockedCalls()external;}
contract ModuleSeparationTest is ProtectedFixture {
 FuturesMathModule fm;LiquidationCalculator lc;AdlCalculator ac;
 function setUp()public override{super.setUp();fm=engine.mathModule();lc=engine.liquidationModule();ac=engine.adlModule();}
 VmModules constant v=VmModules(address(uint160(uint256(keccak256('hevm cheat code')))));
 function exactState()internal view returns(bytes32){bytes32 key=keccak256(abi.encode(A,uint256(1),address(t)));return keccak256(abi.encode(_snapshot(),engine.fundingNonce(key),engine.fundingLedger().lastNonce(key),engine.fundingRemainderRay(A,1,address(t)),engine.fundingLedger().totalPayable(address(t)),engine.fundingLedger().totalReceivable(address(t))));}
 function testModuleHalfUnitsAndSignReversalPreserveExactCarry()public view{(int256 q,int256 c)=fm.funding(5000e18,true,0,true,100000,0);require(q==0&&c==-5e26);(q,c)=fm.funding(5000e18,true,c,true,200000,100000);require(q==-1&&c==0);(q,c)=fm.funding(5000e18,true,-5e26,true,0,100000);require(q==0&&c==0);}
 function testModuleFundingInvalidCarryFailsClosed()public{vm.expectRevert(FuturesMathModule.FundingOverflow.selector);fm.funding(1,true,int256(RAY),true,1,0);}
 function testModuleFundingProductOverflowFailsClosed()public{vm.expectRevert(FuturesMathModule.FundingOverflow.selector);fm.funding(type(uint256).max,true,0,true,2,0);}
 function testModulePnlLongAndShortSigns()public view{require(fm.pnl(5000e18,50000e18,true,60000e18)==1000e18);require(fm.pnl(5000e18,50000e18,false,60000e18)==-1000e18);}
 function testModuleLiquidationMinimumRemainderAndOverflow()public{require(lc.reduction(5000,2500,0)==1250);require(lc.reduction(5000,2500,4000)==5000);vm.expectRevert(LiquidationCalculator.InvalidAmount.selector);lc.reduction(type(uint256).max,2,0);}
 function testModuleFundingCollateralProtectsPnlMaintenanceAndOtherHolds()public view{(uint256 a,uint256 m,uint256 p)=lc.fundingEligibility(1000,100,200,500,200,100,1000);require(a==700&&m==200&&p==100);}
 function testModuleNoCollateralLeavesFullPayable()public view{(uint256 a,uint256 m,uint256 p)=lc.fundingEligibility(0,0,0,0,0,0,15);require(a==0&&m==0&&p==15);(uint256 eligible,bool paid)=ac.fundingCollectionQuote(0,0,0,0,0,0,15);require(eligible==0&&!paid);}
 function testModuleImpossibleOverlappingCollateralReservationRejected()public{vm.expectRevert(LiquidationCalculator.InvalidAmount.selector);lc.fundingEligibility(1000,800,300,500,0,0,1);}
 function testModuleAdlFundingQuoteDoesNotUseReservedCollateral()public view{(uint256 n,bool ok)=ac.fundingCollectionQuote(1000,100,200,500,200,100,1000);require(n==900&&!ok);}
 function testModuleAdlRejectsUnprofitableAndInvalidReduction()public{vm.expectRevert(AdlCalculator.AdlPositionNotProfitable.selector);ac.plan(1000,5000,50000,true,1250,250,40000);vm.expectRevert(AdlCalculator.InvalidReduction.selector);ac.plan(1000,5000,50000,true,5001,250,60000);}
 function testModuleAdlAbsorptionCappedByActualBadDebt()public view{(uint256 released,uint256 absorbed)=ac.plan(1000,5000,50000,true,1250,100,60000);require(released==250&&absorbed==100);}
 function testModulePureContractsExposeNoAssetTransferEntry()public{address[3]memory a=[address(fm),address(lc),address(ac)];uint256 before_=t.balanceOf(address(vault));for(uint256 k;k<3;k++){(bool ok,)=a[k].call(abi.encodeWithSignature('transfer(address,uint256)',A,1));require(!ok);}require(t.balanceOf(address(vault))==before_);}
 function testModuleBadMathReturnRollsBackNonceCarryAndCash()public{_longAndShortFunding();engine.updateFundingIndex(1,DELTA);bytes32 h=exactState();v.mockCall(address(fm),abi.encodeWithSelector(FuturesMathModule.funding.selector),hex'');vm.prank(A);vm.expectRevert();engine.settleFunding(1);v.clearMockedCalls();require(exactState()==h);}
 function testModuleVaultCallRevertBubblesAndRollsBackCompleteClose()public{_longAndShortFunding();engine.updateFundingIndex(1,DELTA);bytes32 h=exactState();v.mockCallRevert(address(vault),abi.encodeWithSelector(Vault.unlockCollateral.selector),abi.encodeWithSignature('Error(string)','release failed'));vm.prank(A);vm.expectRevert();engine.closePosition(1);v.clearMockedCalls();require(exactState()==h);_assertBooks(t);}
 function testModuleNewLiquidationQuoteCannotEnableLedgerLiquidation()public{_open(A,1,true,1000e18,5000e18);reg.setMarketMode(1,Registry.MarketMode.REDUCE_ONLY);engine.configureProtectedLiquidationCandidate(1,false);bytes32 h=exactState();vm.expectRevert(Engine.LedgerLiquidationNotIntegrated.selector);engine.liquidate(A,1);require(exactState()==h);}
 function testModuleCollectibleQuoteCannotEnableUnpaidDebtAdl()public{_debtForAdl(false);engine.configureFunding(1,RAY);_withdraw(A,t,4000e18);engine.updateFundingIndex(1,-DELTA);_settle(A,1);engine.configureAdlSafety(1,true,10000);require(engine.fundingLedger().accountPayable(A,address(t))==15e18);(uint256 eligible,bool quote)=ac.fundingCollectionQuote(0,0,0,1000e18,0,100e18,15e18);require(eligible==900e18&&quote);bytes32 h=exactState();vm.expectRevert(Engine.LedgerDebtOutstanding.selector);engine.executeAdl(A,1,1250e18);require(exactState()==h);}
 function testModuleLegacyReceiptRejectsDoubleCount()public{require(lc.validateLegacyReceipt(-100,0,30,20,40)==10);vm.expectRevert(LiquidationCalculator.FundingOverflow.selector);lc.validateLegacyReceipt(-100,0,30,90,20);}
 function testModuleFreshDeploymentAndBindingAreLocalOnly()public{Registry q=new Registry(address(this));Vault f=new Vault(address(this));Engine e=new Engine(address(q),address(f));f.setEngine(address(e));e.createFundingLedger(10);e.enableFundingWithdrawalProtection();q.bindRiskSource(address(e),address(f));require(e.fundingProtectionReady()&&q.riskEngine()==address(e));}

 function testModuleOracleFailureCannotReleaseFundingWithdrawalHold()public{engine.configureFunding(1,RAY);_open(A,1,true,4000e18,5000e18);_withdraw(A,t,1000e18);engine.updateFundingIndex(1,4e25);_settle(A,1);_deposit(t,A,1000e18);require(vault.withdrawableBalance(A,address(t))==800e18);r.setBroken(true);require(vault.withdrawableBalance(A,address(t))==800e18);vm.prank(A);vm.expectRevert(Vault.InsufficientUnencumberedCollateral.selector);vault.withdraw(address(t),900e18);_withdraw(A,t,800e18);require(vault.availableBalance(A,address(t))==200e18&&engine.fundingLedger().accountPayable(A,address(t))==200e18);_assertBooks(t);}
 function testModuleCollateralMetadataMismatchFailsClosed()public{_open(A,1,true,1000e18,5000e18);bytes32 h=exactState();v.mockCall(address(reg),abi.encodeWithSelector(Registry.marketCollateral.selector),abi.encode(address(u)));vm.prank(A);vm.expectRevert(Vault.FundingProtectionFailure.selector);vault.withdraw(address(t),1);v.clearMockedCalls();require(exactState()==h);}
}
