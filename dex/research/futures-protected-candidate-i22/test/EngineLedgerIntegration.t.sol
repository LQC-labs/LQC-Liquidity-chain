pragma solidity ^0.8.24;
import {FinanceFixture,Engine,Vault,Registry} from './FinanceFixture.sol';
import {FundingLedger} from '../src/funding/FundingLedger.sol';
import {FundingLedgerFactory} from '../src/funding/FundingLedgerFactory.sol';
interface VmEL {function roll(uint256) external;function etch(address,bytes calldata) external;function mockCallRevert(address,bytes calldata,bytes calldata) external;function clearMockedCalls() external;}
contract EngineLedgerIntegrationTest is FinanceFixture {
    VmEL constant ve=VmEL(address(uint160(uint256(keccak256('hevm cheat code')))));
    FundingLedger ledger;
    function setUp() public override {super.setUp();ve.roll(100);ledger=FundingLedger(engine.createFundingLedger(10));}
    function key(address a,uint256 id) internal view returns(bytes32){(,,address tok,,,,)=reg.markets(id);return ledger.key(a,id,tok);}
    function carry(address a) internal view returns(int256){return engine.fundingRemainderRay(a,1,address(t));}
    function domainSnapshot(address actor,uint256 id,address tok) internal view returns(bytes32 h){bytes32 k=key(actor,id);uint256 n=engine.fundingNonce(k);(int256 q,bool ready)=engine.fundingCheckpoint(actor,id,tok,n);h=keccak256(abi.encode(n,q,ready,ledger.lastNonce(k),ledger.receivable(k),ledger.payableAmount(k)));return keccak256(abi.encode(h,ledger.accountPayable(actor,tok),engine.fundingRemainderRay(actor,id,tok)));}
    function claimSnapshot(uint256 k) internal view returns(bytes32){(address a,uint256 m,address tok,uint256 ep,uint256 face,uint256 left,uint256 r)=ledger.claims(k);return keccak256(abi.encode(a,m,tok,ep,face,left,r));}
    function snapshot() internal view returns(bytes32 h){h=keccak256(abi.encode(_snapshot(),engine.legacyActivity(),ledger.claimCount(),ledger.totalReceivable(address(t)),ledger.totalPayable(address(t))));h=keccak256(abi.encode(h,ledger.totalReceivable(address(u)),ledger.totalPayable(address(u)),ledger.reservedCash(address(t)),ledger.reservedCash(address(u))));address[3] memory actors=[A,B,C];
        for(uint256 id=1;id<=reg.marketCount();id++){(,,address tok,,,,)=reg.markets(id);for(uint256 a;a<3;a++)h=keccak256(abi.encode(h,domainSnapshot(actors[a],id,tok)));}
        for(uint256 k=1;k<=ledger.claimCount();k++)h=keccak256(abi.encode(h,claimSnapshot(k)));
        for(uint256 id=1;id<=2;id++){address tok=id==1?address(t):address(u);(bool ok,bytes memory data)=address(ledger).staticcall(abi.encodeWithSelector(FundingLedger.epochState.selector,tok,10));require(ok);h=keccak256(abi.encode(h,data,ledger.head(tok),ledger.queueLength(tok)));}
    }
    function finishEpoch() internal {ve.roll(110);ledger.seal(address(t),10);ledger.startRound(address(t),10);ledger.allocate(address(t),10,32);for(uint256 k=1;k<=ledger.claimCount();k++){(,,,,,,uint256 n)=ledger.claims(k);if(n!=0)ledger.claim(k,n);}}
    function testIntegrationCanonicalFactoryAndOneTimeFreshBinding() public {require(ledger.engine()==address(engine)&&ledger.adapter()==address(engine)&&ledger.vault()==address(vault));require(engine.ledgerFactory().deployedLedger()==address(ledger));vm.expectRevert(Engine.LedgerBindingForbidden.selector);engine.createFundingLedger(10);FundingLedgerFactory factory=engine.ledgerFactory();vm.expectRevert();factory.create(10);}
    function testIntegrationCannotAttachToLegacyAccrualState() public {Engine other=new Engine(address(reg),address(vault));other.configureFunding(1,1e25);other.updateFundingIndex(1,100000);vm.expectRevert(Engine.LedgerBindingForbidden.selector);other.createFundingLedger(10);}
    function testIntegrationActualPayerAndReceiverCashNotFabricated() public {_longAndShortFunding();engine.updateFundingIndex(1,DELTA);_settle(A,1);_settle(B,1);require(vault.availableBalance(A,address(t))==3985e18&&vault.availableBalance(B,address(t))==4000e18&&vault.fundingPoolBalance(address(t))==15e18);require(ledger.receivable(key(B,1))==15e18&&ledger.totalPayable(address(t))==0&&engine.previewFundingPayment(B,1)==0);finishEpoch();require(vault.availableBalance(B,address(t))==4015e18&&vault.fundingPoolBalance(address(t))==0&&ledger.totalReceivable(address(t))==0);_assertBooks(t);}
    function testIntegrationTwentyHalfUnitsPreserveExactRemainderAndLedger() public {_longAndShortFunding();for(uint256 k;k<20;k++){engine.updateFundingIndex(1,100000);_settle(A,1);_settle(B,1);}require(carry(A)==0&&carry(B)==0&&vault.fundingPoolBalance(address(t))==10&&ledger.receivable(key(B,1))==10);finishEpoch();require(vault.availableBalance(A,address(t))==4000e18-10&&vault.availableBalance(B,address(t))==4000e18+10);_assertBooks(t);}
    function testIntegrationPartialAndFullCloseKeepUnpaidReceivable() public {_longAndShortFunding();engine.updateFundingIndex(1,DELTA);_reduce(B,1,2000e18);require(ledger.receivable(key(B,1))==15e18&&vault.availableBalance(B,address(t))==4400e18);_close(B,1);(,,,,bool open)=engine.positions(B,1);require(!open&&ledger.receivable(key(B,1))==15e18&&vault.availableBalance(B,address(t))==5000e18&&vault.fundingPoolBalance(address(t))==0);_assertBooks(t);}
    function testIntegrationFullCloseOppositeReentryKeepsSignedFraction() public {_longAndShortFunding();engine.updateFundingIndex(1,100000);_close(A,1);require(carry(A)==-5e26);_open(A,1,false,1000e18,5000e18);engine.updateFundingIndex(1,-100000);_settle(A,1);require(carry(A)==0&&vault.fundingPoolBalance(address(t))==1&&ledger.totalPayable(address(t))==0);_assertBooks(t);}
    function testIntegrationPartialAndFullAdlCrystallizeUnfundedRights() public {_debtForAdl(false);engine.configureFunding(1,1e25);engine.updateFundingIndex(1,DELTA);engine.configureAdlSafety(1,true,10000);engine.executeAdl(A,1,1250e18);require(ledger.receivable(key(A,1))==15e18&&vault.fundingPoolBalance(address(t))==0&&vault.residualBadDebt(address(t))==125e18);engine.executeAdl(A,1,3750e18);(,,,,bool open)=engine.positions(A,1);require(!open&&ledger.receivable(key(A,1))==15e18&&vault.residualBadDebt(address(t))==0&&vault.availableBalance(A,address(t))==5000e18);_assertBooks(t);}
    function prepareDebt() internal {_debtForAdl(false);engine.configureFunding(1,1e25);engine.updateFundingIndex(1,-DELTA);_withdraw(A,t,4000e18);_settle(A,1);engine.configureAdlSafety(1,true,10000);require(ledger.payableAmount(key(A,1))==15e18&&ledger.accountPayable(A,address(t))==15e18);}
    function testIntegrationUnpaidDebtPreservedAndUnsafeExitAdlBlocked() public {prepareDebt();bytes32 h=snapshot();vm.expectRevert(Engine.LedgerDebtOutstanding.selector);engine.executeAdl(A,1,1250e18);require(snapshot()==h);vm.prank(A);vm.expectRevert(Engine.LedgerDebtOutstanding.selector);engine.closePosition(1);require(snapshot()==h&&ledger.totalPayable(address(t))==15e18&&vault.lockedBalance(A,address(t))==1000e18);_assertBooks(t);}
    function testIntegrationPartialRealCollectionThenAdl() public {prepareDebt();_deposit(t,A,10e18);_settle(A,1);require(ledger.accountPayable(A,address(t))==5e18&&vault.fundingPoolBalance(address(t))==10e18);_deposit(t,A,5e18);_settle(A,1);require(ledger.accountPayable(A,address(t))==0&&vault.fundingPoolBalance(address(t))==15e18);engine.executeAdl(A,1,1250e18);_assertBooks(t);}
    function testIntegrationNonceReplayAndUnauthorizedCashRejected() public {_longAndShortFunding();engine.updateFundingIndex(1,DELTA);_settle(B,1);vm.prank(address(engine));vm.expectRevert(FundingLedger.DuplicateCheckpoint.selector);ledger.crystallize(B,1,address(t),1);vm.prank(A);vm.expectRevert(Engine.Forbidden.selector);engine.pay(A,address(t),1);vm.prank(A);vm.expectRevert(Engine.Forbidden.selector);engine.collect(A,1,address(t),1);require(ledger.totalReceivable(address(t))==15e18);}
    function testIntegrationLedgerRevertRollsBackCheckpointProofAndRemainder() public {_longAndShortFunding();engine.updateFundingIndex(1,100000);bytes32 h=snapshot();bytes memory code=address(ledger).code;ve.etch(address(ledger),hex'60006000fd');vm.prank(A);vm.expectRevert();engine.settleFunding(1);ve.etch(address(ledger),code);require(snapshot()==h&&carry(A)==0&&engine.fundingNonce(key(A,1))==0);}
    function testIntegrationActualVaultFailureRollsBackNewDebtAndNonce() public {_longAndShortFunding();engine.updateFundingIndex(1,DELTA);bytes32 h=snapshot();ve.mockCallRevert(address(vault),abi.encodeWithSelector(Vault.settleFunding.selector),abi.encodeWithSignature('Error(string)','cash rejected'));vm.prank(A);vm.expectRevert();engine.settleFunding(1);ve.clearMockedCalls();require(snapshot()==h&&ledger.totalPayable(address(t))==0&&engine.fundingNonce(key(A,1))==0);}
    function testIntegrationOracleFailureAfterLedgerCashRollsBackEverything() public {_longAndShortFunding();engine.updateFundingIndex(1,DELTA+100000);r.setBroken(true);bytes32 h=snapshot();vm.prank(A);vm.expectRevert();engine.closePosition(1);require(snapshot()==h&&ledger.totalPayable(address(t))==0&&vault.fundingPoolBalance(address(t))==0&&carry(A)==0);}
    function testIntegrationBoundLiquidationIsExplicitlyFailClosed() public {_longAndShortFunding();engine.updateFundingIndex(1,DELTA);_price(35000e18);bytes32 h=snapshot();vm.expectRevert(Engine.LedgerLiquidationNotIntegrated.selector);engine.liquidate(A,1);require(snapshot()==h&&vault.totalInsuranceCovered(address(t))==0);}
    function testIntegrationCrossMarketDebtBlocksSameTokenButNotDistinctCollateral() public {uint256 third=reg.addMarket(bytes32('third'),address(42),address(t),oracle,100000,500);_activate(third);_longAndShortFunding();engine.updateFundingIndex(1,DELTA);_withdraw(A,t,4000e18);_settle(A,1);vm.prank(A);vm.expectRevert(Engine.LedgerDebtOutstanding.selector);engine.openPosition(third,1000e18,5000e18,true);_open(A,2,true,1000e18,5000e18);require(ledger.accountPayable(A,address(t))==15e18&&ledger.accountPayable(A,address(u))==0);_assertBooks(t);_assertBooks(u);}
    function testFuzzIntegrationSignedLifetimeFundingConservation(uint64 seed,uint8 raw) public {_longAndShortFunding();int256 accrued;uint256 steps=1+uint256(raw)%12;for(uint256 k;k<steps;k++){seed=uint64(uint256(keccak256(abi.encode(seed,k))));int256 delta=int256(uint256(seed)%1000000+1);if(seed&1==0)delta=-delta;engine.updateFundingIndex(1,delta);accrued-=int256(5000e18)*delta;_settle(A,1);_settle(B,1);int256 cash=int256(vault.availableBalance(A,address(t)))-int256(4000e18);int256 rights=int256(ledger.receivable(key(A,1)))-int256(ledger.payableAmount(key(A,1)));require(accrued==(cash+rights)*int256(RAY)+carry(A)&&carry(A)==-carry(B));_assertBooks(t);}require(vault.fundingPoolBalance(address(t))==ledger.totalReceivable(address(t)));if(ledger.totalReceivable(address(t))!=0)finishEpoch();int256 paid=int256(vault.availableBalance(A,address(t)))-int256(4000e18);require(accrued==paid*int256(RAY)+carry(A)&&ledger.totalReceivable(address(t))==0&&ledger.totalPayable(address(t))==0);_assertBooks(t);}
}
