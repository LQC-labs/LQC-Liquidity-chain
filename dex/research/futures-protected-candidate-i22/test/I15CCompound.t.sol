pragma solidity ^0.8.24;
import {ProtectedFixture,Engine,Vault,Registry,TestCollateral} from './ProtectedFixture.sol';
import {FundingLedger} from '../src/funding/FundingLedger.sol';
interface VmLiqC {function roll(uint256)external;function mockCall(address,bytes calldata,bytes calldata)external;function mockCallRevert(address,bytes calldata,bytes calldata)external;function clearMockedCalls()external;function etch(address,bytes calldata)external;function load(address,bytes32)external view returns(bytes32);}
import {LiquidationSlots} from './LiquidationSlots.sol';
abstract contract I15CBase is ProtectedFixture {

 VmLiqC constant vl=VmLiqC(address(uint160(uint256(keccak256('hevm cheat code')))));FundingLedger ledger;
 function setUp()public virtual override{super.setUp();vl.roll(100);ledger=engine.fundingLedger();}
 function arm(uint256 id)internal{reg.setMarketMode(id,Registry.MarketMode.REDUCE_ONLY);engine.configureProtectedLiquidationCandidate(id,true);}
 function key(address a,uint256 id)internal view returns(bytes32){return keccak256(abi.encode(a,id,reg.marketCollateral(id)));}
 function due()internal view returns(uint256){return ledger.payableAmount(key(A,1));}
 function prep(int256 delta,uint256 price,uint256 bps)internal{engine.configureFunding(1,RAY);_open(A,1,true,1000e18,5000e18);_withdraw(A,t,4000e18);if(delta!=0)engine.updateFundingIndex(1,delta);_price(price);if(bps!=0)engine.configurePartialLiquidation(1,bps,0);arm(1);}
 function assetHash(TestCollateral token)internal view returns(bytes32 h){address x=address(token);h=keccak256(abi.encode(token.balanceOf(address(vault)),vault.totalAccounted(x),vault.fundingPoolBalance(x)));h=keccak256(abi.encode(h,vault.insuranceFeeReserve(x),vault.treasuryFeeReserve(x)));h=keccak256(abi.encode(h,vault.residualBadDebt(x),vault.totalInsuranceCovered(x)));address[3]memory users=[A,B,C];for(uint256 a;a<3;a++){h=keccak256(abi.encode(h,token.balanceOf(users[a]),token.allowance(users[a],address(vault))));h=keccak256(abi.encode(h,vault.availableBalance(users[a],x),vault.lockedBalance(users[a],x)));}}
 function marketHash(uint256 id)internal view returns(bytes32 h){h=rawHash(address(engine),abi.encodeWithSignature('fundingStates(uint256)',id));h=keccak256(abi.encode(h,engine.openInterestUsd(id),reg.marketMode(id)));h=keccak256(abi.encode(h,reg.policyNonce(id),reg.recoveryApproved(id)));address[3]memory users=[A,B,C];for(uint256 a;a<3;a++){h=keccak256(abi.encode(h,rawHash(address(engine),abi.encodeWithSignature('positions(address,uint256)',users[a],id))));h=keccak256(abi.encode(h,engine.positionFundingEntryRay(users[a],id)));}}
 function rawHash(address target,bytes memory data)internal view returns(bytes32){(bool ok,bytes memory out)=target.staticcall(data);require(ok,'snapshot getter');return keccak256(out);}
 function domainHash(address a,uint256 id)internal view returns(bytes32 h){address token=reg.marketCollateral(id);bytes32 k=key(a,id);uint256 nonce=engine.fundingNonce(k);h=keccak256(abi.encode(nonce,ledger.lastNonce(k)));h=keccak256(abi.encode(h,ledger.payableAmount(k),ledger.receivable(k)));h=keccak256(abi.encode(h,engine.fundingRemainderRay(a,id,token),engine.protectedLiquidationCandidate(id)));h=keccak256(abi.encode(h,rawHash(address(engine),abi.encodeWithSignature('fundingCheckpoint(address,uint256,address,uint256)',a,id,token,nonce))));}
 function state()internal view returns(bytes32 h){h=keccak256(abi.encode(assetHash(t),assetHash(u)));for(uint256 m=1;m<=reg.marketCount();m++)h=keccak256(abi.encode(h,marketHash(m)));h=keccak256(abi.encode(h,ledger.claimCount(),ledger.reservedCash(address(t))));address[3]memory actors=[A,B,C];for(uint256 i;i<3;i++)for(uint256 id=1;id<=reg.marketCount();id++)h=keccak256(abi.encode(h,domainHash(actors[i],id)));h=keccak256(abi.encode(h,vl.load(address(engine),bytes32(LiquidationSlots.ENGINE_LOCK))));h=keccak256(abi.encode(h,vl.load(address(ledger),bytes32(LiquidationSlots.LEDGER_LOCK)),vl.load(address(vault),bytes32(LiquidationSlots.VAULT_LOCK))));for(uint256 id=1;id<=ledger.claimCount();id++)h=keccak256(abi.encode(h,rawHash(address(ledger),abi.encodeWithSignature('claims(uint256)',id))));}
 function rejectLiq(bytes4 selector)internal{bytes32 h=state();vm.expectRevert(selector);engine.liquidate(A,1);require(state()==h,'liquidation rollback');}
 function mockFail(address target,bytes4 selector)internal{vl.mockCallRevert(target,abi.encodeWithSelector(selector),abi.encodeWithSignature('Error(string)','injected failure'));}
 function rejectGeneric()internal{bytes32 h=state();vm.expectRevert();engine.liquidate(A,1);vl.clearMockedCalls();require(state()==h,'failure state changed');}
 function insure()internal{engine.configureTradingFee(1,1000,5000);_open(B,1,true,1000e18,1000e18);engine.configureTradingFee(1,0,0);engine.configureInsuranceCoverage(1,10000);require(vault.insuranceFeeReserve(address(t))==50e18&&vault.treasuryFeeReserve(address(t))==50e18);}

 function assertProtected()internal view{require(engine.withdrawalProtectionEnabled()&&engine.fundingProtectionReady()&&vault.fundingWithdrawalProtection(),'protection disabled');require(reg.riskEngine()==address(engine)&&reg.riskVault()==address(vault)&&engine.withdrawalVerifier().bindingsValid(),'binding mismatch');}
 function inventoryHash(address who,address tok)internal view returns(bytes32 h){h=keccak256(abi.encode(vault.otherReservedCollateral(who,tok),ledger.accountPayable(who,tok)));h=keccak256(abi.encode(h,engine.fundingActiveCount(who,tok),engine.fundingActiveSize(who,tok)));h=keccak256(abi.encode(h,engine.fundingMarketCommitment(who,tok),engine.negativeRemainderHolds(who,tok)));for(uint256 k;k<engine.fundingMarketLength(who,tok);k++)h=keccak256(abi.encode(h,engine.fundingMarketAt(who,tok,k)));}
 function digest()public view returns(bytes32 h){h=state();address[2]memory toks=[address(t),address(u)];for(uint256 j;j<2;j++){address tok=toks[j];h=keccak256(abi.encode(h,ledger.totalPayable(tok),ledger.totalReceivable(tok)));h=keccak256(abi.encode(h,ledger.reservedCash(tok),ledger.head(tok),ledger.queueLength(tok)));for(uint256 q;q<ledger.queueLength(tok);q++){uint256 ep=ledger.queuedEpoch(tok,q);h=keccak256(abi.encode(h,ep,rawHash(address(ledger),abi.encodeWithSelector(FundingLedger.epochState.selector,tok,ep))));}h=keccak256(abi.encode(h,rawHash(address(ledger),abi.encodeWithSelector(FundingLedger.epochState.selector,tok,ledger.currentEpoch()))));h=keccak256(abi.encode(h,inventoryHash(A,tok),inventoryHash(B,tok),inventoryHash(C,tok)));}h=keccak256(abi.encode(h,address(engine).codehash,address(vault).codehash));h=keccak256(abi.encode(h,address(ledger).codehash,address(engine.withdrawalVerifier()).codehash,address(reg).codehash));}

}
contract I15CCompoundTest is I15CBase {
 function testCPartialBlockedAdlHealthyFullAttemptRejectsAtomically()public{assertProtected();prep(12e25+100000,47500e18,5000);engine.liquidate(A,1);require(due()==600e18);bytes32 h=digest();vm.expectRevert(Engine.AdlNotEnabled.selector);engine.executeAdl(A,1,1e18);require(digest()==h);engine.configurePartialLiquidation(1,10000,0);h=digest();vm.expectRevert(Engine.NotLiquidatable.selector);engine.liquidate(A,1);require(digest()==h&&due()==600e18&&vault.fundingPoolBalance(address(t))==0);_assertBooks(t);}
 function testCPartialBlockedAdlThenWorsenedPriceFullLiquidation()public{assertProtected();prep(12e25+100000,47500e18,5000);engine.liquidate(A,1);bytes32 h=digest();vm.expectRevert(Engine.AdlNotEnabled.selector);engine.executeAdl(A,1,1e18);require(digest()==h);_price(42500e18);engine.configurePartialLiquidation(1,10000,0);engine.liquidate(A,1);require(due()==100e18+1&&vault.fundingPoolBalance(address(t))==500e18-1&&vault.availableBalance(A,address(t))==1&&engine.fundingRemainderRay(A,1,address(t))==-5e26&&vault.residualBadDebt(address(t))==0);_assertBooks(t);assertProtected();}
 function testCConfirmPartialLiquidationReconfirmAndLiquidate()public{assertProtected();prep(12e25,47500e18,5000);_settle(A,1);require(due()==600e18&&engine.fundingNonce(key(A,1))==1);engine.liquidate(A,1);engine.updateFundingIndex(1,1e26);_settle(A,1);require(due()==250e18);engine.liquidate(A,1);require(due()==1625e17&&vault.fundingPoolBalance(address(t))==6875e17&&engine.fundingNonce(key(A,1))==4);require(due()+vault.fundingPoolBalance(address(t))==850e18);_assertBooks(t);}
 function testCClosedFractionReentryOppositeDirectionCancelsExactly()public{assertProtected();prep(100000,42500e18,0);engine.liquidate(A,1);require(engine.fundingRemainderRay(A,1,address(t))==-5e26);_activate(1);_open(A,1,false,100e18,500e18);engine.updateFundingIndex(1,1000000);_settle(A,1);require(due()==0&&ledger.receivable(key(A,1))==0&&engine.fundingRemainderRay(A,1,address(t))==0&&vault.fundingPoolBalance(address(t))==0);_close(A,1);require(vault.availableBalance(A,address(t))==250e18);_assertBooks(t);}
 function receiverAndPayer()internal{engine.configureFunding(1,RAY);_open(A,1,false,1000e18,5000e18);_open(B,1,true,1000e18,5000e18);_withdraw(A,t,4000e18);_withdraw(B,t,4000e18);engine.updateFundingIndex(1,DELTA);_price(60000e18);arm(1);engine.liquidate(A,1);_settle(B,1);require(ledger.receivable(key(A,1))==15e18&&ledger.payableAmount(key(B,1))==15e18&&vault.fundingPoolBalance(address(t))==0);}
 function testCPoolShortagePartialPayoutThenFullFundingSettlement()public{assertProtected();receiverAndPayer();bytes32 h=digest();vm.prank(B);vm.expectRevert(Vault.InsufficientAvailableBalance.selector);engine.repayFundingDebt(1,1);require(digest()==h);_deposit(t,B,7e18);vm.prank(B);engine.repayFundingDebt(1,7e18);vl.roll(110);ledger.seal(address(t),10);ledger.startRound(address(t),10);ledger.allocate(address(t),10,32);ledger.claim(1,3e18);ledger.claim(1,4e18);require(ledger.receivable(key(A,1))==8e18&&ledger.payableAmount(key(B,1))==8e18&&vault.fundingPoolBalance(address(t))==0);h=digest();vm.expectRevert(FundingLedger.InvalidInput.selector);ledger.claim(1,1);require(digest()==h);_deposit(t,B,8e18);vm.prank(B);engine.repayFundingDebt(1,8e18);ledger.startRound(address(t),10);ledger.allocate(address(t),10,32);ledger.claim(1,8e18);require(ledger.receivable(key(A,1))==0&&ledger.payableAmount(key(B,1))==0&&vault.availableBalance(A,address(t))==15e18&&vault.fundingPoolBalance(address(t))==0);h=digest();vm.expectRevert(FundingLedger.InvalidInput.selector);ledger.claim(1,1);require(digest()==h);_assertBooks(t);}
 function testCPnlInsuranceShortfallAndFundingPayableRemainSeparate()public{assertProtected();insure();prep(2e26,35000e18,0);engine.liquidate(A,1);require(due()==1000e18&&vault.residualBadDebt(address(t))==450e18&&vault.insuranceFeeReserve(address(t))==0&&vault.treasuryFeeReserve(address(t))==50e18);_deposit(t,A,1000e18);vm.prank(A);engine.repayFundingDebt(1,1000e18);require(due()==0&&vault.residualBadDebt(address(t))==450e18&&vault.fundingPoolBalance(address(t))==1000e18&&vault.totalInsuranceCovered(address(t))==50e18&&vault.treasuryFeeReserve(address(t))==50e18);_assertBooks(t);}
 function testCLateClaimFailurePreservesReceivableAndReservation()public{assertProtected();receiverAndPayer();_deposit(t,B,15e18);vm.prank(B);engine.repayFundingDebt(1,15e18);vl.roll(110);ledger.seal(address(t),10);ledger.startRound(address(t),10);ledger.allocate(address(t),10,32);bytes32 h=digest();mockFail(address(vault),Vault.settleFunding.selector);vm.expectRevert();ledger.claim(1,15e18);vl.clearMockedCalls();require(digest()==h&&ledger.receivable(key(A,1))==15e18&&ledger.reservedCash(address(t))==15e18);ledger.claim(1,15e18);_assertBooks(t);}
 function testCDeviationAfterFundingConfirmPreservesAllState()public{assertProtected();prep(12e25,47500e18,5000);_settle(A,1);p.set(50000e18,1000);bytes32 h=digest();vm.expectRevert();engine.liquidate(A,1);require(digest()==h);}
 function testCStaleAfterPartialLiquidationPreservesAllState()public{assertProtected();prep(12e25,47500e18,5000);engine.liquidate(A,1);vm.warp(1301);bytes32 h=digest();vm.expectRevert();engine.liquidate(A,1);require(digest()==h);}
 function testCReferenceFailureAfterConfirmationPreservesAllState()public{assertProtected();prep(12e25,47500e18,5000);_settle(A,1);r.setBroken(true);bytes32 h=digest();vm.expectRevert();engine.liquidate(A,1);require(digest()==h);}
 function testCRepeatedCollectionAndNonceCannotEraseDebt()public{assertProtected();prep(12e25,47500e18,5000);engine.liquidate(A,1);bytes32 h=digest();vm.prank(A);vm.expectRevert(FundingLedger.InvalidInput.selector);engine.repayFundingDebt(1,1);require(digest()==h);vm.prank(address(engine));vm.expectRevert(FundingLedger.DuplicateCheckpoint.selector);ledger.crystallize(A,1,address(t),1);require(digest()==h);}
 function testCNonOwnerAdlAttemptAfterLiquidationPreservesState()public{assertProtected();prep(12e25,47500e18,5000);engine.liquidate(A,1);bytes32 h=digest();vm.prank(A);vm.expectRevert(Engine.Forbidden.selector);engine.executeAdl(A,1,1);require(digest()==h);}
}
