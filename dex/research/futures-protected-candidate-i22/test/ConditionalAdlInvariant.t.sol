pragma solidity ^0.8.24;
import {ConditionalAdlFixture,Engine,Vault,Registry,TestCollateral,FundingLedger} from './ConditionalAdl.t.sol';
/// Test-only independent signed Funding ledger and ADL collateral/debt shadow model.
contract ConditionalAdlHandler is ConditionalAdlFixture {
 struct Ref{uint256 size;uint256 margin;uint256 entry;int256 accrued;int256 pending;int256 rem;int256 cash;uint256 receive_;uint256 pay_;uint256 nonce;int256 checkpoint;}
 Ref[2]private refs;uint256[2]private av;int256 private idx;uint256 private mark=35000e18;uint256 private custody;uint256 private debt;uint256 private other;uint8 private mode_=1;bytes32 private uHash;
 uint256 public actions;uint256 public adls;uint256 public collections;uint256 public payouts;uint256 public generations;uint256 public rejected;
 function who(uint256 n)public pure returns(address){return n%2==0?A:C;}
 function setUp()public override{super.setUp();_open(C,1,true,1000e18,5000e18);prepare(0,0);refs[0].size=5000e18;refs[0].margin=1000e18;refs[0].entry=50000e18;refs[1].size=5000e18;refs[1].margin=1000e18;refs[1].entry=50000e18;av[0]=0;av[1]=4000e18;custody=t.balanceOf(address(vault));debt=500e18;uHash=_collateralSnapshot(u);checkAll();}
 function min(uint256 a,uint256 b)internal pure returns(uint256){return a<b?a:b;}
 function book(uint256 a)internal{Ref storage q=refs[a];int256 x=q.pending+q.rem;int256 p=x/int256(RAY);q.rem=x%int256(RAY);q.pending=0;q.checkpoint=idx;q.nonce++;if(p>0)q.receive_+=uint256(p);else q.pay_+=uint256(-p);}
 function hold(uint256 a)internal view returns(uint256 h){Ref storage q=refs[a];int256 x=q.pending+q.rem;int256 p=x/int256(RAY);h=q.pay_;if(p<0)h+=uint256(-p);if(x%int256(RAY)<0)h++;if(a==0)h+=other;}
 function attempt(address actor_,bytes memory data)internal returns(bool ok){bytes32 h=snap();vm.prank(actor_);(ok,)=address(engine).call(data);if(!ok){require(snap()==h,'failed Engine partial state');rejected++;}}
 function normal(uint256 a)internal{book(a);uint256 reserved=a==0?other:0;uint256 n=min(refs[a].pay_,av[a]-reserved);refs[a].pay_-=n;refs[a].cash-=int256(n);av[a]-=n;}
 function actFunding(uint256 seed,bool negative)external{actions++;int256 d=int256((seed%10+1)*3e24+(seed%3)*100000);if(negative)d=-d;engine.updateFundingIndex(1,d);idx+=d;for(uint256 a;a<2;a++){int256 n=int256(refs[a].size)*(a==0?d:-d);refs[a].accrued+=n;refs[a].pending+=n;}checkAll();}
 function actSettle(uint256 seed)external{actions++;uint256 a=seed%2;if(attempt(who(a),abi.encodeCall(Engine.settleFunding,(uint256(1)))))normal(a);checkAll();}
 function actAdl(uint256 seed)external{actions++;Ref storage q=refs[0];uint256 n=seed%3==0?q.size:seed%3==1?q.size/4:q.size/2;uint256 released=q.size!=0?q.margin*n/q.size:0;uint256 profit=q.entry>mark?(q.entry-mark)*n/q.entry:0;int256 exact=q.pending+q.rem;int256 p=exact/int256(RAY);uint256 payable_=q.pay_+(p<0?uint256(-p):0);uint256 reserved=other+(exact%int256(RAY)<0?1:0);bool allowed=mode_<2&&debt!=0&&q.size!=0&&n!=0&&released!=0&&profit!=0&&q.margin-released>=(q.size-n)*500/10000&&av[0]+released>=reserved+payable_;
 bool ok=attempt(address(this),abi.encodeCall(Engine.executeAdl,(A,uint256(1),n)));require(ok==allowed,'ADL availability differs from policy');if(ok){book(0);require(refs[0].pay_==payable_);av[0]+=released;av[0]-=payable_;q.cash-=int256(payable_);q.pay_=0;q.size-=n;q.margin-=released;if(q.size==0)q.checkpoint=0;debt-=min(profit,debt);adls++;if(payable_!=0)collections++;}checkAll();}
 function actRepay(uint256 seed,uint256 amountSeed)external{actions++;uint256 a=seed%2;uint256 reserved=a==0?other:0;uint256 free=av[a]>reserved?av[a]-reserved:0;uint256 n=min(refs[a].pay_,free);if(amountSeed%2!=0)n=n/2;if(n==0)n=1;if(attempt(who(a),abi.encodeCall(Engine.repayFundingDebt,(uint256(1),n)))){refs[a].pay_-=n;refs[a].cash-=int256(n);av[a]-=n;collections++;}checkAll();}
 function actDeposit(uint256 seed,uint256 amountSeed)external{actions++;uint256 a=seed%2;uint256 n=(amountSeed%100+1)*1e18;_deposit(t,who(a),n);av[a]+=n;custody+=n;checkAll();}
 function actReservation()external{actions++;bytes memory data=other==0?abi.encodeCall(Engine.reserveOtherCollateral,(address(t),bytes32('other'),uint256(5e18))):abi.encodeCall(Engine.releaseOtherCollateral,(address(t),bytes32('other')));if(attempt(A,data))other=other==0?5e18:0;checkAll();}
 function actWithdraw(uint256 seed,uint256 amountSeed)external{actions++;uint256 a=seed%2;uint256 h=hold(a);uint256 free=av[a]>h?av[a]-h:0;uint256 n=amountSeed%2==0?free:free+1;bytes32 before_=snap();vm.prank(who(a));(bool ok,)=address(vault).call(abi.encodeCall(Vault.withdraw,(address(t),n)));if(ok){require(n!=0&&n<=free);av[a]-=n;custody-=n;}else{require(snap()==before_,'withdraw rollback');rejected++;}checkAll();}
 function actPrice(uint256 seed)external{actions++;uint256[5]memory prices=[uint256(20000e18),25000e18,35000e18,40000e18,45000e18];mark=prices[seed%5];_price(mark);checkAll();}
 function actHalt(bool halted)external{actions++;reg.setMarketMode(1,halted?Registry.MarketMode.HALTED:Registry.MarketMode.REDUCE_ONLY);mode_=halted?2:1;checkAll();}
 function regenerate()external{require(msg.sender==address(this));reg.setMarketMode(1,Registry.MarketMode.REDUCE_ONLY);_price(50000e18);_activate(1);if(refs[0].size==0){_deposit(t,A,1001e18);_open(A,1,false,1000e18,5000e18);}_deposit(t,B,1000e18);_open(B,1,true,1000e18,5000e18);_price(35000e18);_close(B,1);reg.setMarketMode(1,Registry.MarketMode.REDUCE_ONLY);}
 function actRegenerate()external{actions++;if(debt!=0||refs[0].size==0&&refs[0].pay_!=0)return;bytes32 before_=snap();bool reopen=refs[0].size==0;try this.regenerate(){if(reopen){av[0]+=1e18;custody+=1001e18;refs[0].size=5000e18;refs[0].margin=1000e18;refs[0].entry=50000e18;refs[0].checkpoint=idx;}custody+=1000e18;debt=500e18;mark=35000e18;mode_=1;generations++;}catch{require(snap()==before_,'regeneration rollback');rejected++;}checkAll();}
 function tryLedger(bytes memory data)internal returns(bool ok){bytes32 h=snap();(ok,)=address(ledger).call(data);if(!ok){require(snap()==h,'Ledger rollback');rejected++;}}
 function actClaim(uint256 seed)external{actions++;if(ledger.claimCount()>64)return;if(ledger.head(address(t))<ledger.queueLength(address(t))){uint256 ep=ledger.queuedEpoch(address(t),ledger.head(address(t)));if(ledger.currentEpoch()<=ep)vl.roll((ep+1)*10);(,,bool sealed_,bool active,,,,,,)=ledger.epochState(address(t),ep);if(!sealed_)tryLedger(abi.encodeCall(FundingLedger.seal,(address(t),ep)));if(!active)tryLedger(abi.encodeCall(FundingLedger.startRound,(address(t),ep)));(,,,active,,,,,,)=ledger.epochState(address(t),ep);if(active)tryLedger(abi.encodeCall(FundingLedger.allocate,(address(t),ep,32)));}uint256 count=ledger.claimCount();if(count!=0){uint256 id=seed%count+1;(address w,,address token,,,,uint256 reserved)=ledger.claims(id);require(token==address(t));uint256 n=reserved==0?1:reserved;if(tryLedger(abi.encodeCall(FundingLedger.claim,(id,n)))){require(w==A||w==C);uint256 a=w==A?0:1;refs[a].receive_-=n;refs[a].cash+=int256(n);av[a]+=n;payouts++;}}tryLedger(abi.encodeCall(FundingLedger.advance,(address(t),32)));checkAll();}
 function actLateFault()external{actions++;bytes32 h=snap();vl.mockCallRevert(address(vault),abi.encodeWithSelector(Vault.absorbAdlBadDebt.selector),abi.encodeWithSignature('Error(string)','late ADL fault'));require(!attempt(address(this),abi.encodeCall(Engine.executeAdl,(A,uint256(1),refs[0].size))),'fault escaped');vl.clearMockedCalls();require(snap()==h,'late fault state');checkAll();}
 function checkRole(uint256 a)internal view{Ref storage q=refs[a];address w=who(a);(uint256 margin,uint256 size,uint256 entry,bool long_,bool open)=engine.positions(w,1);require(size==q.size&&margin==q.margin&&open==(size!=0),'position model');if(open)require(entry==q.entry&&long_==(a==1));bytes32 k=key(w,1);require(ledger.receivable(k)==q.receive_&&ledger.payableAmount(k)==q.pay_,'R/P shadow ledger');require(engine.fundingNonce(k)==q.nonce&&ledger.lastNonce(k)==q.nonce,'nonce model');require(engine.positionFundingEntryRay(w,1)==q.checkpoint,'checkpoint model');require(engine.fundingRemainderRay(w,1,address(t))==q.rem&&q.rem<int256(RAY)&&q.rem>-int256(RAY),'signed remainder');(int256 p,int256 rem)=engine.previewFundingDomain(w,1,address(t));require(p==(q.pending+q.rem)/int256(RAY)&&rem==(q.pending+q.rem)%int256(RAY),'pending model');require(q.accrued==(q.cash+int256(q.receive_)-int256(q.pay_))*int256(RAY)+q.rem+q.pending,'exact Funding conservation');require(vault.availableBalance(w,address(t))==av[a]&&vault.lockedBalance(w,address(t))==q.margin,'collateral model');uint256 h=hold(a);require(vault.withdrawableBalance(w,address(t))==(av[a]>h?av[a]-h:0),'withdrawal holds');}
 function checkAll()public view{assertConditional();require(engine.adlEnabled(1)&&uint8(reg.marketMode(1))==mode_);checkRole(0);checkRole(1);require(engine.openInterestUsd(1)==refs[0].size+refs[1].size,'OI');int256 cash=refs[0].cash+refs[1].cash;require(cash<=0&&vault.fundingPoolBalance(address(t))==uint256(-cash),'actual pool/cash');require(ledger.totalReceivable(address(t))==refs[0].receive_+refs[1].receive_&&ledger.totalPayable(address(t))==refs[0].pay_+refs[1].pay_,'ledger totals');require(vault.residualBadDebt(address(t))==debt&&vault.insuranceFeeReserve(address(t))==0&&vault.treasuryFeeReserve(address(t))==0&&vault.totalInsuranceCovered(address(t))==0,'ADL vs Funding vs insurance');require(vault.otherReservedCollateral(A,address(t))==other&&vault.availableBalance(B,address(t))==4000e18&&vault.lockedBalance(B,address(t))==0,'other collateral untouched');uint256 accounted=av[0]+refs[0].margin+av[1]+refs[1].margin+4000e18;require(vault.totalAccounted(address(t))==accounted&&t.balanceOf(address(vault))==custody&&custody>=accounted+uint256(-cash),'custody coverage');require(ledger.reservedCash(address(t))<=uint256(-cash)&&_collateralSnapshot(u)==uHash,'cash reservation/other asset');}
}
contract ConditionalAdlInvariantTest {
 struct FuzzSelector{address addr;bytes4[]selectors;}ConditionalAdlHandler public handler;event log_named_uint(string name,uint256 value);
 function setUp()public{handler=new ConditionalAdlHandler();handler.setUp();handler.actFunding(1,true);handler.actAdl(1);require(handler.adls()==1,'seeded conditional ADL absent');}
 function targetContracts()external view returns(address[]memory a){a=new address[](1);a[0]=address(handler);}
 function targetSelectors()external view returns(FuzzSelector[]memory a){a=new FuzzSelector[](1);bytes4[]memory s=new bytes4[](12);s[0]=ConditionalAdlHandler.actFunding.selector;s[1]=ConditionalAdlHandler.actAdl.selector;s[2]=ConditionalAdlHandler.actSettle.selector;s[3]=ConditionalAdlHandler.actRepay.selector;s[4]=ConditionalAdlHandler.actDeposit.selector;s[5]=ConditionalAdlHandler.actReservation.selector;s[6]=ConditionalAdlHandler.actWithdraw.selector;s[7]=ConditionalAdlHandler.actPrice.selector;s[8]=ConditionalAdlHandler.actHalt.selector;s[9]=ConditionalAdlHandler.actRegenerate.selector;s[10]=ConditionalAdlHandler.actClaim.selector;s[11]=ConditionalAdlHandler.actLateFault.selector;a[0]=FuzzSelector(address(handler),s);}
 function invariant_fundingCollateralAndDebtConserve()public view{handler.checkAll();}
 function afterInvariant()public view{handler.checkAll();require(handler.adls()>=1&&handler.actions()>2);}
}
