pragma solidity ^0.8.24;
import {I15CBase,Engine,Vault,Registry,TestCollateral,FundingLedger} from './I15CCompound.t.sol';
/// TEST ONLY: independent signed RAY book, custody and available/position/PnL models.
contract I15CHandler is I15CBase {
 struct Ref{uint256 size;uint256 margin;uint256 entry;bool long_;int256 accrued;int256 pending;int256 rem;int256 cash;uint256 receive_;uint256 pay_;uint256 nonce;int256 checkpoint;int256 lastBooked;}
 struct TokenRef{uint256 custody;uint256 insurance;uint256 treasury;uint256 debt;uint256 covered;}
 mapping(address=>mapping(uint256=>Ref)) private refs;
 mapping(address=>mapping(address=>uint256)) private av;
 mapping(address=>mapping(address=>uint256)) private reservations;
 mapping(address=>TokenRef) private tokens;
 mapping(uint256=>int256)private idx;mapping(uint256=>uint256)private mark;
 uint256 public actions;uint256 public accepted;uint256 public rejected;uint256 public liquidations;uint256 public claimsPaid;uint256 public reentries;
 uint256[13] public successes;
 function actor(uint256 n)public pure returns(address){return n%3==0?A:n%3==1?B:C;}
 function tok(uint256 m)public view returns(address){return m==2?address(u):address(t);}
 function setUp()public override{
  super.setUp();uint256 m3=reg.addMarket(bytes32('SHARED'),address(42),address(t),oracle,100000,500);require(m3==3);_activate(3);
  engine.configureTradingFee(1,1000,5000);_open(C,1,true,1000e18,1000e18);engine.configureTradingFee(1,0,0);
  _open(A,1,true,1000e18,5000e18);_open(B,1,false,1000e18,5000e18);_open(A,3,false,800e18,3000e18);_open(B,3,true,800e18,3000e18);_open(C,3,true,800e18,3000e18);
  _open(A,2,true,800e18,3000e18);_open(B,2,false,800e18,3000e18);_open(C,2,true,600e18,2000e18);
  vm.prank(A);engine.reserveOtherCollateral(address(t),bytes32('handler'),100e18);reservations[A][address(t)]=100e18;
  _withdraw(A,t,3000e18);_withdraw(B,t,3000e18);_withdraw(C,t,2900e18);_withdraw(A,u,4000e18);_withdraw(B,u,4000e18);_withdraw(C,u,4200e18);
  // Explicit, actually minted local-test surplus backing positive PnL. Not Funding or an unbacked receivable.
  t.mint(address(vault),100000e18);u.mint(address(vault),100000e18);
  for(uint256 m=1;m<=3;m++){engine.configureFunding(m,RAY);engine.configureInsuranceCoverage(m,10000);engine.configurePartialLiquidation(m,5000,0);arm(m);mark[m]=m==2?2000e18:50000e18;for(uint256 a;a<3;a++){address w=actor(a);Ref storage q=refs[w][m];(q.margin,q.size,q.entry,q.long_,)=engine.positions(w,m);}}
  for(uint256 j;j<2;j++){address t_=j==0?address(t):address(u);tokens[t_]=TokenRef(TestCollateral(t_).balanceOf(address(vault)),vault.insuranceFeeReserve(t_),vault.treasuryFeeReserve(t_),0,0);for(uint256 a;a<3;a++){address w=actor(a);av[w][t_]=vault.availableBalance(w,t_);}}
  checkAll();
 }
 function min(uint256 x,uint256 y)internal pure returns(uint256){return x<y?x:y;}
 function pnl(Ref storage q,uint256 n,uint256 price)internal view returns(int256){return q.long_?(int256(price)-int256(q.entry))*int256(n)/int256(q.entry):(int256(q.entry)-int256(price))*int256(n)/int256(q.entry);}
 function book(address w,uint256 m)internal{Ref storage q=refs[w][m];int256 exact=q.pending+q.rem;int256 whole=exact/int256(RAY);q.rem=exact%int256(RAY);q.pending=0;q.checkpoint=idx[m];q.nonce++;q.lastBooked=whole;if(whole>0)q.receive_+=uint256(whole);else q.pay_+=uint256(-whole);}
 function normalFunding(address w,uint256 m)internal{book(w,m);Ref storage q=refs[w][m];address token=tok(m);uint256 n=min(q.pay_,av[w][token]-reservations[w][token]);q.pay_-=n;av[w][token]-=n;q.cash-=int256(n);}
 function accountPayable(address w,address token)internal view returns(uint256 n){for(uint256 m=1;m<=3;m++)if(tok(m)==token)n+=refs[w][m].pay_;}
 function required(address w,address token)public view returns(uint256 n){for(uint256 m=1;m<=3;m++)if(tok(m)==token){Ref storage q=refs[w][m];n+=q.pay_;int256 exact=q.pending+q.rem;int256 whole=exact/int256(RAY);if(whole<0)n+=uint256(-whole);if(exact%int256(RAY)<0)n++;}}
 function tryEngine(address w,bytes memory input)internal returns(bool ok){bytes32 before_=digest();vm.prank(w);(ok,)=address(engine).call(input);if(!ok){require(digest()==before_,'failed Engine changed state');rejected++;}else accepted++;}
 function applyPnl(address w,uint256 m,uint256 margin,int256 result)internal{address token=tok(m);if(result>=0)av[w][token]+=margin+uint256(result);else{uint256 loss=uint256(-result);if(loss<margin)av[w][token]+=margin-loss;else{uint256 deficit=loss-margin;uint256 cover=min(deficit,tokens[token].insurance);tokens[token].insurance-=cover;tokens[token].covered+=cover;tokens[token].debt+=deficit-cover;}}}
 function actFunding(uint256 marketSeed,uint256 amountSeed,bool negative)external{actions++;uint256 m=marketSeed%3+1;int256 delta=int256((amountSeed%7+1)*1e24+(amountSeed%3)*100000);if(negative)delta=-delta;engine.updateFundingIndex(m,delta);idx[m]+=delta;for(uint256 a;a<3;a++){Ref storage q=refs[actor(a)][m];int256 n=int256(q.size)*(q.long_?-delta:delta);q.accrued+=n;q.pending+=n;}successes[0]++;checkAll();}
 function actPrice(uint256 seed)external{actions++;uint256[6]memory b=[uint256(35000),42500,47500,50000,52500,60000];uint256 price=b[seed%6]*1e18;_price(price);mark[1]=price;mark[3]=price;uint256 e=price*2000/50000;p2.set(int256(e),1000);r2.set(int256(e),1000);mark[2]=e;successes[1]++;checkAll();}
 function actSettle(uint256 who,uint256 marketSeed)external{actions++;address w=actor(who);uint256 m=marketSeed%3+1;if(refs[w][m].size==0)return;if(tryEngine(w,abi.encodeCall(Engine.settleFunding,(m)))){normalFunding(w,m);successes[2]++;}checkAll();}
 function recover(address w,uint256 m)internal{Ref storage q=refs[w][m];if(q.pay_==0)return;address token=tok(m);uint256 other=reservations[w][token]+required(w,token)-q.pay_;if(other>av[w][token])return;uint256 fromA=min(q.pay_,av[w][token]-other);uint256 reserve;if(q.size!=0){int256 pp=pnl(q,q.size,mark[m]);uint256 loss=pp<0?uint256(-pp):0;reserve=min(q.margin,loss+q.size*500/10000);}uint256 fromM=min(q.pay_-fromA,q.margin-reserve);q.margin-=fromM;av[w][token]-=fromA;q.pay_-=fromA+fromM;q.cash-=int256(fromA+fromM);}
 function actLiquidate(uint256 who,uint256 marketSeed)external{actions++;address w=actor(who);uint256 m=marketSeed%3+1;Ref storage q=refs[w][m];if(q.size==0)return;if(tryEngine(address(this),abi.encodeCall(Engine.liquidate,(w,m)))){book(w,m);int256 fullPnl=pnl(q,q.size,mark[m]);uint256 equity=fullPnl>=0?q.margin+uint256(fullPnl):uint256(-fullPnl)<q.margin?q.margin-uint256(-fullPnl):0;uint256 maintenance=q.size*500/10000;if(equity>maintenance){uint256 gap=equity-maintenance;require(q.pay_>=gap||(q.rem<0&&gap-q.pay_==1),'healthy liquidation bypass');}uint256 n=q.size/2;if(n==0)n=q.size;int256 result=pnl(q,n,mark[m]);bool full=n==q.size||q.margin==0||(result<0&&uint256(-result)>=q.margin);if(full){result=pnl(q,q.size,mark[m]);applyPnl(w,m,q.margin,result);q.size=0;q.margin=0;q.checkpoint=0;}else{q.size-=n;if(result<0)q.margin-=uint256(-result);else av[w][tok(m)]+=uint256(result);}recover(w,m);liquidations++;successes[3]++;}checkAll();}
 function actReduce(uint256 who,uint256 marketSeed,bool full)external{actions++;address w=actor(who);uint256 m=marketSeed%3+1;Ref storage q=refs[w][m];if(q.size==0)return;uint256 n=full?q.size:q.size/2;if(tryEngine(w,abi.encodeCall(Engine.reducePosition,(m,n)))){normalFunding(w,m);require(accountPayable(w,tok(m))==0,'reduce bypassed payable');uint256 released=q.margin*n/q.size;int256 result=pnl(q,n,mark[m]);applyPnl(w,m,released,result);q.size-=n;q.margin-=released;if(q.size==0)q.checkpoint=0;successes[4]++;}checkAll();}
 function performOpen(address w,uint256 m,bool long_)external{require(msg.sender==address(this));_activate(m);_open(w,m,long_,100e18,500e18);reg.setMarketMode(m,Registry.MarketMode.REDUCE_ONLY);}
 function actReenter(uint256 who,uint256 marketSeed,bool long_)external{actions++;address w=actor(who);uint256 m=marketSeed%3+1;Ref storage q=refs[w][m];if(q.size!=0)return;bytes32 before_=digest();try this.performOpen(w,m,long_){require(accountPayable(w,tok(m))==0);q.size=500e18;q.margin=100e18;q.entry=mark[m];q.long_=long_;q.checkpoint=idx[m];av[w][tok(m)]-=100e18;reentries++;successes[5]++;}catch{require(digest()==before_,'failed reentry changed state');rejected++;}checkAll();}
 function tryLedger(bytes memory input)internal returns(bool ok){bytes32 before_=digest();(ok,)=address(ledger).call(input);if(!ok){require(digest()==before_,'failed Ledger changed state');rejected++;}}
 function actClaim(uint256 seed,uint256 amountSeed)external{actions++;address token=seed%2==0?address(t):address(u);uint256 head_=ledger.head(token);if(head_>=ledger.queueLength(token)||ledger.claimCount()>64)return;uint256 ep=ledger.queuedEpoch(token,head_);if(ledger.currentEpoch()<=ep)vl.roll((ep+1)*10);(,,bool sealed_,bool active,,,,,,)=ledger.epochState(token,ep);if(!sealed_)tryLedger(abi.encodeCall(FundingLedger.seal,(token,ep)));if(!active)tryLedger(abi.encodeCall(FundingLedger.startRound,(token,ep)));(,,,active,,,,,,)=ledger.epochState(token,ep);if(active)tryLedger(abi.encodeCall(FundingLedger.allocate,(token,ep,32)));uint256 count=ledger.claimCount();if(count!=0){uint256 id=seed%count+1;(address w,uint256 m,address ct,,,uint256 remaining,uint256 reserved)=ledger.claims(id);if(reserved!=0){uint256 n=amountSeed%2==0?reserved:min(reserved,remaining)/2;if(n==0)n=1;if(tryLedger(abi.encodeCall(FundingLedger.claim,(id,n)))){refs[w][m].receive_-=n;refs[w][m].cash+=int256(n);av[w][ct]+=n;claimsPaid++;successes[6]++;}}}tryLedger(abi.encodeCall(FundingLedger.advance,(token,32)));checkAll();}
 function actWithdraw(uint256 who,uint256 tokenSeed,uint256 amountSeed)external{actions++;address w=actor(who);address token=tokenSeed%2==0?address(t):address(u);uint256 hold=required(w,token)+reservations[w][token];uint256 free=hold<av[w][token]?av[w][token]-hold:0;require(vault.withdrawableBalance(w,token)==free,'withdraw model');uint256 n=amountSeed%3==0?free:amountSeed%3==1?free+1:av[w][token]+1;bytes32 before_=digest();vm.prank(w);(bool ok,)=address(vault).call(abi.encodeCall(Vault.withdraw,(token,n)));if(ok){require(n!=0&&n<=free,'unreserved withdrawal');av[w][token]-=n;tokens[token].custody-=n;successes[7]++;}else{require(digest()==before_,'withdraw rollback');rejected++;}checkAll();}
 function actRepay(uint256 who,uint256 marketSeed)external{actions++;address w=actor(who);uint256 m=marketSeed%3+1;Ref storage q=refs[w][m];address token=tok(m);uint256 n=min(q.pay_,av[w][token]>=reservations[w][token]?av[w][token]-reservations[w][token]:0);if(n==0)n=1;if(tryEngine(w,abi.encodeCall(Engine.repayFundingDebt,(m,n)))){q.pay_-=n;q.cash-=int256(n);av[w][token]-=n;successes[12]++;}checkAll();}
 function endDebt()external view returns(uint256){return tokens[address(t)].debt+tokens[address(u)].debt;}
 function endPayable()external view returns(uint256){return ledger.totalPayable(address(t))+ledger.totalPayable(address(u));}
 function endReceivable()external view returns(uint256){return ledger.totalReceivable(address(t))+ledger.totalReceivable(address(u));}
 function actDeposit(uint256 who,uint256 tokenSeed,uint256 amountSeed)external{actions++;address w=actor(who);TestCollateral token=tokenSeed%2==0?t:u;uint256 n=(amountSeed%100+1)*1e18;_deposit(token,w,n);av[w][address(token)]+=n;tokens[address(token)].custody+=n;successes[8]++;checkAll();}
 function actReservation(uint256 who,uint256 tokenSeed)external{actions++;address w=actor(who);address token=tokenSeed%2==0?address(t):address(u);uint256 n=reservations[w][token];bytes memory data=n==0?abi.encodeCall(Engine.reserveOtherCollateral,(token,bytes32('handler'),uint256(1e18))):abi.encodeCall(Engine.releaseOtherCollateral,(token,bytes32('handler')));if(tryEngine(w,data)){reservations[w][token]=n==0?1e18:0;successes[9]++;}checkAll();}
 function actBlockedAdl(uint256 who,uint256 marketSeed)external{actions++;address w=actor(who);uint256 m=marketSeed%3+1;require(!engine.adlEnabled(m),'conditional ADL unexpectedly enabled');require(!tryEngine(address(this),abi.encodeCall(Engine.executeAdl,(w,m,uint256(1)))),'blocked ADL succeeded');successes[10]++;checkAll();}
 function actFault(uint256 who,uint256 marketSeed)external{actions++;address w=actor(who);uint256 m=marketSeed%3+1;if(refs[w][m].size==0)return;bytes32 before_=digest();vl.mockCallRevert(address(ledger),abi.encodeWithSelector(FundingLedger.crystallize.selector),abi.encodeWithSignature('Error(string)','I15C injected'));require(!tryEngine(w,abi.encodeCall(Engine.settleFunding,(m))),'fault call succeeded');vl.clearMockedCalls();require(digest()==before_,'fault rollback');successes[11]++;checkAll();}
 function checkAll()public view{assertProtected();for(uint256 m=1;m<=3;m++){(int256 actualIndex,,)=engine.fundingStates(m);require(actualIndex==idx[m],'index model');uint256 oi;for(uint256 a;a<3;a++){address w=actor(a);Ref storage q=refs[w][m];(uint256 margin,uint256 size,uint256 entry,bool long_,bool open)=engine.positions(w,m);require(size==q.size&&margin==q.margin&&open==(q.size!=0),'position model');if(open)require(entry==q.entry&&long_==q.long_,'direction model');require(engine.positionFundingEntryRay(w,m)==q.checkpoint,'checkpoint model');bytes32 k=key(w,m);require(ledger.receivable(k)==q.receive_&&ledger.payableAmount(k)==q.pay_,'independent ledger');require(engine.fundingRemainderRay(w,m,tok(m))==q.rem&&q.rem<int256(RAY)&&q.rem>-int256(RAY),'remainder model');require(engine.fundingNonce(k)==q.nonce&&ledger.lastNonce(k)==q.nonce,'nonce model');(int256 payment,int256 remainder)=engine.previewFundingDomain(w,m,tok(m));require(payment==(q.pending+q.rem)/int256(RAY)&&remainder==(q.pending+q.rem)%int256(RAY),'pending model');require(q.accrued==(q.cash+int256(q.receive_)-int256(q.pay_))*int256(RAY)+q.rem+q.pending,'signed RAY conservation');oi+=q.size;}require(engine.openInterestUsd(m)==oi,'independent OI');}
 for(uint256 j;j<2;j++){address token=j==0?address(t):address(u);uint256 totalR;uint256 totalP;uint256 userClaims;int256 netCash;for(uint256 a;a<3;a++){address w=actor(a);require(vault.availableBalance(w,token)==av[w][token]&&vault.otherReservedCollateral(w,token)==reservations[w][token],'available/reservation model');require(vault.withdrawableBalance(w,token)==(av[w][token]>required(w,token)+reservations[w][token]?av[w][token]-required(w,token)-reservations[w][token]:0),'aggregate hold');uint256 locked;for(uint256 m=1;m<=3;m++)if(tok(m)==token){Ref storage q=refs[w][m];totalR+=q.receive_;totalP+=q.pay_;netCash+=q.cash;locked+=q.margin;}require(vault.lockedBalance(w,token)==locked&&ledger.accountPayable(w,token)==accountPayable(w,token),'locked/account debt');userClaims+=av[w][token]+locked;}require(ledger.totalReceivable(token)==totalR&&ledger.totalPayable(token)==totalP,'global ledger');require(netCash<=0&&vault.fundingPoolBalance(token)==uint256(-netCash),'pool/net cash');TokenRef storage tr=tokens[token];require(vault.totalAccounted(token)==userClaims&&TestCollateral(token).balanceOf(address(vault))==tr.custody,'custody/book');require(vault.insuranceFeeReserve(token)==tr.insurance&&vault.treasuryFeeReserve(token)==tr.treasury&&vault.residualBadDebt(token)==tr.debt&&vault.totalInsuranceCovered(token)==tr.covered,'PnL vs Funding sources');require(tr.custody>=userClaims+uint256(-netCash)+tr.insurance+tr.treasury&&ledger.reservedCash(token)<=uint256(-netCash),'asset coverage/reservation');}
 }
}
contract I15CFundingInvariantTest {
 struct FuzzSelector{address addr;bytes4[] selectors;}
 event log_named_uint(string key,uint256 val);
 I15CHandler public handler;
 function setUp()public{handler=new I15CHandler();handler.setUp();}
 function targetContracts()external view returns(address[]memory a){a=new address[](1);a[0]=address(handler);}
 function targetSelectors()external view returns(FuzzSelector[]memory a){a=new FuzzSelector[](1);bytes4[]memory s=new bytes4[](13);s[0]=I15CHandler.actFunding.selector;s[1]=I15CHandler.actPrice.selector;s[2]=I15CHandler.actSettle.selector;s[3]=I15CHandler.actLiquidate.selector;s[4]=I15CHandler.actReduce.selector;s[5]=I15CHandler.actReenter.selector;s[6]=I15CHandler.actClaim.selector;s[7]=I15CHandler.actWithdraw.selector;s[8]=I15CHandler.actDeposit.selector;s[9]=I15CHandler.actReservation.selector;s[10]=I15CHandler.actBlockedAdl.selector;s[11]=I15CHandler.actFault.selector;s[12]=I15CHandler.actRepay.selector;a[0]=FuzzSelector(address(handler),s);}
 function invariant_referenceFundingCustodyAndOi()public view{handler.checkAll();}
 function afterInvariant()public{require(handler.actions()>0,'vacuous campaign');handler.checkAll();emit log_named_uint('actions',handler.actions());emit log_named_uint('accepted',handler.accepted());emit log_named_uint('rejected',handler.rejected());emit log_named_uint('liquidations',handler.liquidations());emit log_named_uint('claimsPaid',handler.claimsPaid());emit log_named_uint('reentries',handler.reentries());emit log_named_uint('repayments',handler.successes(12));emit log_named_uint('endDebt',handler.endDebt());emit log_named_uint('endPayable',handler.endPayable());emit log_named_uint('endReceivable',handler.endReceivable());}
}
