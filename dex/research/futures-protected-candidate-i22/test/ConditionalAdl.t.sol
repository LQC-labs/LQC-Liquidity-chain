 function testI16InsuranceAndTreasuryNeverFundPayable()public{engine.configureTradingFee(1,1000,5000);_open(C,1,true,1000e18,1000e18);engine.configureTradingFee(1,0,0);prepare(-DELTA,0);engine.executeAdl(A,1,1250e18);require(vault.insuranceFeeReserve(address(t))==50e18&&vault.treasuryFeeReserve(address(t))==50e18&&vault.totalInsuranceCovered(address(t))==0&&vault.residualBadDebt(address(t))==125e18&&vault.fundingPoolBalance(address(t))==15e18);_assertBooks(t);}
