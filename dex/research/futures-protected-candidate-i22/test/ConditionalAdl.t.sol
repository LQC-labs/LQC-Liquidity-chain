pragma solidity ^0.8.24;
import {I15CBase,Engine,Vault,Registry,TestCollateral,FundingLedger} from './I15CCompound.t.sol';
interface VmI16{function expectRevert(bytes calldata)external;}
abstract contract ConditionalAdlFixture is I15CBase {
 function enableConditional()internal{reg.setMarketMode(1,Registry.MarketMode.REDUCE_ONLY);engine.configureConditionalAdlCandidate(1,true);engine.configureAdlSafety(1,true,10000);}
 function prepare(int256 delta,uint256 keepAvailable)internal{_debtForAdl(false);engine.configureFunding(1,RAY);if(keepAvailable<4000e18)_withdraw(A,t,4000e18-keepAvailable);if(delta!=0)engine.updateFundingIndex(1,delta);enableConditional();assertConditional();}
 function assertConditional()internal view{assertProtected();require(engine.conditionalAdlCandidate(1),'candidate off');}
 function snap()internal view returns(bytes32){return keccak256(abi.encode(digest(),engine.conditionalAdlCandidate(1),engine.adlEnabled(1),engine.maxAdlReductionBps(1)));}
 function reject(bytes4 error_)internal{bytes32 h=snap();vm.expectRevert(error_);engine.executeAdl(A,1,1250e18);require(snap()==h,'conditional rollback');}
 function position(uint256 margin,uint256 size)internal view{(uint256 m,uint256 s,,,bool open)=engine.positions(A,1);require(m==margin&&s==size&&open==(size!=0),'position amount');}
}
contract AdlCallbackToken {
 mapping(address=>uint256)private balances;mapping(address=>mapping(address=>uint256))public allowance;address public target;address public custody;uint256 public market;bool public armed;
 function mint(address a,uint256 n)external{balances[a]+=n;}function approve(address a,uint256 n)external returns(bool){allowance[msg.sender][a]=n;return true;}function transfer(address a,uint256 n)external returns(bool){balances[msg.sender]-=n;balances[a]+=n;return true;}function transferFrom(address a,address b,uint256 n)external returns(bool){allowance[a][msg.sender]-=n;balances[a]-=n;balances[b]+=n;return true;}
 function arm(address e,address v,uint256 m,bool a)external{target=e;custody=v;market=m;armed=a;}
 function balanceOf(address a)external view returns(uint256){if(armed&&a==custody){(bool ok,bytes memory ret)=target.staticcall(abi.encodeWithSignature('repayFundingDebt(uint256,uint256)',market,1));require(!ok&&ret.length>=4&&bytes4(ret)==Engine.ProtectedReentrancy.selector,'ADL callback escaped lock');}return balances[a];}
}
