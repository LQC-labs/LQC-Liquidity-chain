 function testI16OtherPositionAndReservationRemainUntouched()public{uint256 id=reg.addMarket(bytes32('OTHER'),address(42),address(t),oracle,100000,500);_activate(id);_open(A,id,true,1000e18,1000e18);vm.prank(A);engine.reserveOtherCollateral(address(t),bytes32('order'),100e18);_debtForAdl(false);_withdraw(A,t,2900e18);engine.configureFunding(1,RAY);engine.updateFundingIndex(1,-DELTA);enableConditional();bytes32 h=_position(A,id);engine.executeAdl(A,1,1250e18);require(_position(A,id)==h&&vault.lockedBalance(A,address(t))==1750e18&&vault.otherReservedCollateral(A,address(t))==100e18&&vault.availableBalance(A,address(t))==335e18);_assertBooks(t);}
