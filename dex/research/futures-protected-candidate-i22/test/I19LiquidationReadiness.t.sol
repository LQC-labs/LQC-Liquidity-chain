pragma solidity ^0.8.24;
import {I15CBase,Engine,Vault,Registry,TestCollateral,FundingLedger} from "./I15CCompound.t.sol";
interface VmI19 {function store(address,bytes32,bytes32)external;}
contract I19FlagOnlyEngine {function protectedLiquidationCandidate(uint256)external pure returns(bool){return true;}function fundingProtectionReady()external pure returns(bool){return true;}function liquidationReady(uint256)external pure returns(bool){return true;}}
contract I19LiquidationReadinessTest is I15CBase {
 function off()internal{reg.setMarketMode(1,Registry.MarketMode.REDUCE_ONLY);engine.configureProtectedLiquidationCandidate(1,false);require(!reg.liquidationReady(1));}
 function pending()internal{reg.setMarketMode(1,Registry.MarketMode.REDUCE_ONLY);reg.setRecoveryApproved(1,true);}
 function rejectOpen(bytes4 why)internal{bytes32 h=digest();vm.prank(A);vm.expectRevert(why);engine.openPosition(1,100e18,500e18,true);require(digest()==h,"entry accounting changed");}
 function rejectRecoveries()internal{bytes32 h=digest();vm.expectRevert(Registry.RiskUnverified.selector);reg.setMarketActive(1,true);vm.expectRevert(Registry.RiskUnverified.selector);reg.setMarketMode(1,Registry.MarketMode.ACTIVE);vm.expectRevert(Registry.RiskUnverified.selector);reg.setEmergencyMarketMode(1,Registry.MarketMode.ACTIVE);require(digest()==h,"recovery mutated state");}
 function fakeEntryGate()internal{vl.mockCall(address(reg),abi.encodeWithSelector(Registry.markets.selector,uint256(1)),abi.encode(bytes32("BTC"),address(42),address(t),oracle,uint32(100000),uint32(500),true));}
 function testI19PreparedStructureAndRealEntry()public{require(reg.liquidationReady(1)&&reg.liquidationReady(2));_open(A,1,true,100e18,500e18);require(engine.openInterestUsd(1)==500e18);_assertBooks(t);}
 function testI19UnknownAndHaltedReturnNotReady()public{require(!reg.liquidationReady(0)&&!reg.liquidationReady(999));reg.setMarketMode(1,Registry.MarketMode.HALTED);require(!reg.liquidationReady(1));rejectOpen(Engine.MarketInactive.selector);}
 function testI19NewMarketOffCannotApproveOrEnter()public{uint256 id=reg.addMarket(bytes32("OFF"),address(42),address(t),oracle,100000,500);require(!engine.protectedLiquidationCandidate(id)&&!reg.liquidationReady(id));reg.setMarketMode(id,Registry.MarketMode.REDUCE_ONLY);vm.expectRevert(Registry.RiskUnverified.selector);reg.setRecoveryApproved(id,true);vm.prank(A);vm.expectRevert(Engine.MarketInactive.selector);engine.openPosition(id,100e18,500e18,true);require(engine.openInterestUsd(id)==0);}
 function testI19OffCannotApprove()public{off();bytes32 h=digest();vm.expectRevert(Registry.RiskUnverified.selector);reg.setRecoveryApproved(1,true);require(!reg.recoveryApproved(1)&&digest()==h);}
 function testI19OffCannotEnter()public{off();rejectOpen(Engine.MarketInactive.selector);}
 function testI19EngineRechecksAfterForgedActiveTuple()public{off();fakeEntryGate();vl.mockCall(address(reg),abi.encodeWithSelector(bytes4(keccak256("marketMode(uint256)")),uint256(1)),abi.encode(Registry.MarketMode.ACTIVE));rejectOpen(Engine.FundingProtectionInvalid.selector);vl.clearMockedCalls();}
 function testI19EngineRejectsReadyQueryFailure()public{fakeEntryGate();mockFail(address(reg),Registry.liquidationReady.selector);bytes32 h=digest();vm.prank(A);vm.expectRevert();engine.openPosition(1,100e18,500e18,true);require(digest()==h);vl.clearMockedCalls();}
 function testI19AllThreeRecoveryPathsRecheckOff()public{pending();vl.mockCall(address(engine),abi.encodeWithSelector(bytes4(keccak256("protectedLiquidationCandidate(uint256)")),uint256(1)),abi.encode(false));rejectRecoveries();vl.clearMockedCalls();require(reg.recoveryApproved(1));reg.setMarketActive(1,true);require(!reg.recoveryApproved(1));}
 function testI19EnabledFlagWithUnsupportedCollateralIsNotReady()public{require(engine.protectedLiquidationCandidate(1));vault.setSupportedCollateral(address(t),false);require(!reg.liquidationReady(1));fakeEntryGate();rejectOpen(Engine.FundingProtectionInvalid.selector);vl.clearMockedCalls();}
 function testI19CollateralChangeBlocksApprovalAndAllRecoveries()public{pending();vault.setSupportedCollateral(address(t),false);rejectRecoveries();vm.expectRevert(Registry.RiskUnverified.selector);reg.setRecoveryApproved(1,true);vault.setSupportedCollateral(address(t),true);reg.setMarketActive(1,true);}
 function testI19UnbackedVaultCannotAdmit()public{vl.mockCall(address(t),abi.encodeWithSelector(bytes4(keccak256("balanceOf(address)")),address(vault)),abi.encode(uint256(0)));require(!reg.liquidationReady(1));fakeEntryGate();rejectOpen(Engine.FundingProtectionInvalid.selector);vl.clearMockedCalls();_assertBooks(t);}
 function testI19CoverageFailureBlocksAllRecoveries()public{pending();mockFail(address(vault),Vault.isFullyBacked.selector);rejectRecoveries();require(!reg.liquidationReady(1));vl.clearMockedCalls();}
 function testI19SupportedGetterFailureFailsClosed()public{mockFail(address(vault),bytes4(keccak256("supportedCollateral(address)")));require(!reg.liquidationReady(1));fakeEntryGate();rejectOpen(Engine.FundingProtectionInvalid.selector);vl.clearMockedCalls();}
 function testI19InvalidLiquidationReductionFailsClosed()public{vl.mockCall(address(engine),abi.encodeWithSelector(bytes4(keccak256("liquidationReductionBps(uint256)")),uint256(1)),abi.encode(uint256(10001)));require(!reg.liquidationReady(1));fakeEntryGate();rejectOpen(Engine.FundingProtectionInvalid.selector);vl.clearMockedCalls();}
 function testI19FlagReadFailureFailsClosed()public{mockFail(address(engine),bytes4(keccak256("protectedLiquidationCandidate(uint256)")));require(!reg.liquidationReady(1));vl.clearMockedCalls();}
 function testI19FlagOnlyFakeCodeCannotAuthenticate()public{I19FlagOnlyEngine fake=new I19FlagOnlyEngine();bytes memory code=address(engine).code;vl.etch(address(engine),address(fake).code);require(!reg.liquidationReady(1));vl.etch(address(engine),code);require(reg.liquidationReady(1));}
 function testI19FlagDoesNotAuthenticateWrongLedgerRole()public{pending();vl.mockCall(address(ledger),abi.encodeWithSignature("engine()"),abi.encode(B));require(!reg.liquidationReady(1));rejectRecoveries();vl.clearMockedCalls();}
 function testI19FlagDoesNotAuthenticateWrongVaultEngine()public{pending();vl.mockCall(address(vault),abi.encodeWithSelector(bytes4(keccak256("engine()"))),abi.encode(B));require(!reg.liquidationReady(1));rejectRecoveries();vl.clearMockedCalls();}
 function testI19FlagDoesNotAuthenticateWrongFactory()public{pending();vl.mockCall(address(engine.ledgerFactory()),abi.encodeWithSignature("deployedLedger()"),abi.encode(B));require(!reg.liquidationReady(1));rejectRecoveries();vl.clearMockedCalls();}
 function testI19FlagDoesNotAuthenticateWrongVerifier()public{pending();vl.mockCall(address(engine.ledgerFactory()),abi.encodeWithSignature("deployedWithdrawalVerifier()"),abi.encode(B));require(!reg.liquidationReady(1));rejectRecoveries();vl.clearMockedCalls();}
 function testI19LiquidationModuleCodeMutationCannotPass()public{bytes memory code=address(engine.liquidationModule()).code;vl.etch(address(engine.liquidationModule()),hex"00");require(!reg.liquidationReady(1));vl.etch(address(engine.liquidationModule()),code);require(reg.liquidationReady(1));}
 function testI19LedgerCodeMutationCannotPass()public{bytes memory code=address(ledger).code;vl.etch(address(ledger),hex"00");require(!reg.liquidationReady(1));vl.etch(address(ledger),code);require(reg.liquidationReady(1));}
 function testI19WrongRiskEngineCannotEnter()public{vl.mockCall(address(reg),abi.encodeWithSignature("riskEngine()"),abi.encode(B));rejectOpen(Engine.FundingProtectionInvalid.selector);vl.clearMockedCalls();}
 function testI19ProtectionOffCannotPassFlag()public{vl.mockCall(address(vault),abi.encodeWithSignature("fundingWithdrawalProtection()"),abi.encode(false));require(!reg.liquidationReady(1));vl.clearMockedCalls();}
 function testI19GuardianCannotApproveOrRestore()public{off();reg.setGuardian(B);vm.prank(B);vm.expectRevert(Registry.Forbidden.selector);reg.setRecoveryApproved(1,true);vm.prank(B);vm.expectRevert(Registry.Forbidden.selector);reg.setEmergencyMarketMode(1,Registry.MarketMode.ACTIVE);require(!reg.liquidationReady(1));}
 function testI19OwnerCannotEnableInActive()public{vm.expectRevert(Engine.FundingProtectionInvalid.selector);engine.configureProtectedLiquidationCandidate(1,false);require(reg.liquidationReady(1));}
 function testI19OracleReferenceAnd500PolicyStillRequired()public{ctrl.clearCircuitBreaker(address(42));require(!reg.liquidationReady(1));rejectOpen(Engine.MarketInactive.selector);ctrl.setCircuitBreaker(address(42),address(r),500);require(!reg.liquidationReady(1));}
 function testI19OracleErrorCannotPassFlag()public{r.setBroken(true);require(!reg.liquidationReady(1));rejectOpen(Engine.MarketInactive.selector);}
 function testI19OwnerChangeInvalidatesReadyAndApproval()public{pending();reg.transferOwnership(B);vm.prank(B);reg.acceptOwnership();require(!reg.liquidationReady(1)&&!reg.recoveryApproved(1));vm.prank(B);vm.expectRevert(Registry.InvalidRecovery.selector);reg.setMarketActive(1,true);}
 function testI19EmergencyRepetitionInvalidatesApproval()public{pending();reg.applyEmergencyTriggers(1,true,true,true);require(!reg.recoveryApproved(1));vm.expectRevert(Registry.InvalidRecovery.selector);reg.setMarketActive(1,true);}
 function testI19ApprovalExpiresAt900AndIsOneUse()public{pending();vm.warp(1900);p.set(50000e18,1900);r.set(50000e18,1900);vm.expectRevert(Registry.InvalidRecovery.selector);reg.setMarketActive(1,true);reg.setRecoveryApproved(1,true);reg.setMarketActive(1,true);reg.setMarketMode(1,Registry.MarketMode.REDUCE_ONLY);vm.expectRevert(Registry.InvalidRecovery.selector);reg.setMarketActive(1,true);}
 function testI19FlagEnabledCannotClearResidualDebtGate()public{reg.setMarketMode(1,Registry.MarketMode.REDUCE_ONLY);vm.prank(address(engine));vault.coverBadDebt(address(t),1,0);vm.expectRevert(Registry.ResidualDebt.selector);reg.setRecoveryApproved(1,true);require(engine.protectedLiquidationCandidate(1));}
 function testI19ReadyReductionAllowsActualProtectedLiquidation()public{engine.configureFunding(1,RAY);_open(A,1,true,1000e18,5000e18);_withdraw(A,t,4000e18);engine.updateFundingIndex(1,12e25+100000);_price(47500e18);engine.configurePartialLiquidation(1,5000,0);arm(1);require(reg.liquidationReady(1));engine.liquidate(A,1);require(due()==600e18&&engine.fundingRemainderRay(A,1,address(t))==-5e26);_assertBooks(t);}
 function testI19ReadinessIsReadOnly()public{bytes32 h=digest();for(uint256 i;i<5;i++)require(reg.liquidationReady(1));require(digest()==h);}
}

