pragma solidity ^0.8.24;
import {ProtectedFixture,Engine,Vault,Registry} from './ProtectedFixture.sol';
import {FundingLedger} from '../src/funding/FundingLedger.sol';
interface VmAdmission {function mockCall(address,bytes calldata,bytes calldata)external;function clearMockedCalls()external;function etch(address,bytes calldata)external;function roll(uint256)external;}
contract FakeAdmissionEngine {address public registry;address public vault;constructor(address r,address v){registry=r;vault=v;}function fundingProtectionReady()external pure returns(bool){return true;}function ledgerFactory()external view returns(address){return address(this);}}
contract ProtectedAdmissionTest is ProtectedFixture {
 VmAdmission constant va=VmAdmission(address(uint160(uint256(keccak256('hevm cheat code')))));
 function rejectEntry()internal{bytes32 before_=_snapshot();vm.prank(A);vm.expectRevert();engine.openPosition(1,100e18,500e18,true);require(_snapshot()==before_,'failed-entry changed accounts');}
 function mockValue(address target,string memory sig,bytes memory value)internal{va.mockCall(target,abi.encodeWithSelector(bytes4(keccak256(bytes(sig)))),value);}
 function restore()internal{va.clearMockedCalls();require(engine.fundingProtectionReady());}
 function reduceAndApprove()internal{reg.setMarketMode(1,Registry.MarketMode.REDUCE_ONLY);reg.setRecoveryApproved(1,true);}
 function testAdmissionProtectedBootstrapAndRealEntry()public{require(engine.fundingProtectionReady()&&vault.fundingWithdrawalProtection());(bool ok,uint256 debt)=reg.verifiedResidualDebt(1);require(ok&&debt==0);_open(A,1,true,100e18,500e18);_assertBooks(t);}
 function testAdmissionNoLedgerCannotBind()public{Registry q=new Registry(address(this));Vault v=new Vault(address(this));Engine e=new Engine(address(q),address(v));v.setEngine(address(e));vm.expectRevert(Registry.RiskUnverified.selector);q.bindRiskSource(address(e),address(v));require(!q.riskSourceSealed());}
 function testAdmissionLedgerWithoutProtectionCannotBind()public{Registry q=new Registry(address(this));Vault v=new Vault(address(this));Engine e=new Engine(address(q),address(v));v.setEngine(address(e));e.createFundingLedger(10);vm.expectRevert(Registry.RiskUnverified.selector);q.bindRiskSource(address(e),address(v));}
 function testAdmissionWrongVaultCannotBind()public{Registry q=new Registry(address(this));Vault v=new Vault(address(this));Vault wrong=new Vault(address(this));Engine e=new Engine(address(q),address(v));v.setEngine(address(e));wrong.setEngine(address(e));e.createFundingLedger(10);e.enableFundingWithdrawalProtection();vm.expectRevert(Registry.RiskUnverified.selector);q.bindRiskSource(address(e),address(wrong));}
 function testAdmissionGetterSpoofCannotBind()public{Registry q=new Registry(address(this));Vault v=new Vault(address(this));FakeAdmissionEngine fake=new FakeAdmissionEngine(address(q),address(v));v.setEngine(address(fake));vm.expectRevert(Registry.RiskUnverified.selector);q.bindRiskSource(address(fake),address(v));}
 function testAdmissionOtherUnprotectedEngineCannotEnter()public{Vault v=new Vault(address(this));Engine e=new Engine(address(reg),address(v));v.setEngine(address(e));vm.prank(A);vm.expectRevert(Engine.FundingProtectionInvalid.selector);e.openPosition(1,100e18,500e18,true);require(e.openInterestUsd(1)==0&&v.totalAccounted(address(t))==0);}
 function testAdmissionOtherProtectedEngineCannotEnter()public{Vault v=new Vault(address(this));Engine e=new Engine(address(reg),address(v));v.setEngine(address(e));e.createFundingLedger(10);e.enableFundingWithdrawalProtection();vm.prank(A);vm.expectRevert(Engine.FundingProtectionInvalid.selector);e.openPosition(1,100e18,500e18,true);require(e.openInterestUsd(1)==0);}
 function testAdmissionEngineProtectionOffBlocksLiveEntry()public{mockValue(address(engine),'withdrawalProtectionEnabled()',abi.encode(false));require(!engine.fundingProtectionReady());rejectEntry();restore();}
 function testAdmissionVaultProtectionOffBlocksLiveEntry()public{mockValue(address(vault),'fundingWithdrawalProtection()',abi.encode(false));rejectEntry();restore();}
 function testAdmissionWrongLedgerRoleBlocksLiveEntry()public{mockValue(address(engine.fundingLedger()),'engine()',abi.encode(B));rejectEntry();restore();}
 function testAdmissionWrongVaultLedgerBlocksLiveEntry()public{mockValue(address(vault),'protectionLedger()',abi.encode(B));rejectEntry();restore();}
 function testAdmissionWrongFactoryLedgerBlocksLiveEntry()public{mockValue(address(engine.ledgerFactory()),'deployedLedger()',abi.encode(B));rejectEntry();restore();}
 function testAdmissionWrongVerifierLinkBlocksLiveEntry()public{mockValue(address(engine.ledgerFactory()),'deployedWithdrawalVerifier()',abi.encode(B));rejectEntry();restore();}
 function testAdmissionVerifierCodeMutationBlocksLiveEntry()public{address v=address(engine.withdrawalVerifier());bytes memory code=v.code;va.etch(v,hex'00');rejectEntry();va.etch(v,code);require(engine.fundingProtectionReady());}
 function testAdmissionLedgerCodeMutationBlocksLiveEntry()public{address l=address(engine.fundingLedger());bytes memory code=l.code;va.etch(l,hex'00');rejectEntry();va.etch(l,code);require(engine.fundingProtectionReady());}
 function testAdmissionVaultCodeMutationBlocksLiveEntry()public{bytes memory code=address(vault).code;va.etch(address(vault),hex'00');vm.prank(A);vm.expectRevert();engine.openPosition(1,100e18,500e18,true);va.etch(address(vault),code);require(engine.fundingProtectionReady());}
 function testAdmissionCannotRebindOrDisableProtectedVault()public{vm.expectRevert(Vault.ProtectionLocked.selector);vault.setEngine(B);vm.expectRevert(Engine.FundingProtectionInvalid.selector);engine.enableFundingWithdrawalProtection();vm.expectRevert(Registry.PolicyLocked.selector);reg.bindRiskSource(address(engine),address(vault));require(engine.fundingProtectionReady());}
 function testAdmissionRecoveryViaSetMarketMode()public{reduceAndApprove();reg.setMarketMode(1,Registry.MarketMode.ACTIVE);require(!reg.recoveryApproved(1));_open(A,1,true,100e18,500e18);}
 function testAdmissionRecoveryViaSetMarketActive()public{reduceAndApprove();reg.setMarketActive(1,true);require(!reg.recoveryApproved(1));_open(A,1,true,100e18,500e18);}
 function testAdmissionRecoveryViaEmergencyOwner()public{reduceAndApprove();reg.setEmergencyMarketMode(1,Registry.MarketMode.ACTIVE);require(!reg.recoveryApproved(1));_open(A,1,true,100e18,500e18);}
 function testAdmissionProtectionFailureBlocksAllThreeApprovedRecoveries()public{reduceAndApprove();mockValue(address(vault),'fundingWithdrawalProtection()',abi.encode(false));vm.expectRevert(Registry.RiskUnverified.selector);reg.setMarketMode(1,Registry.MarketMode.ACTIVE);vm.expectRevert(Registry.RiskUnverified.selector);reg.setMarketActive(1,true);vm.expectRevert(Registry.RiskUnverified.selector);reg.setEmergencyMarketMode(1,Registry.MarketMode.ACTIVE);restore();}
 function testAdmissionProtectionFailureBlocksApproval()public{reg.setMarketMode(1,Registry.MarketMode.REDUCE_ONLY);mockValue(address(vault),'fundingWithdrawalProtection()',abi.encode(false));vm.expectRevert(Registry.RiskUnverified.selector);reg.setRecoveryApproved(1,true);restore();}
 function testAdmissionExpiredApprovalAt900Seconds()public{reduceAndApprove();vm.warp(1900);p.set(50000e18,1900);r.set(50000e18,1900);vm.expectRevert(Registry.InvalidRecovery.selector);reg.setMarketActive(1,true);require(!reg.recoveryApproved(1));}
 function testAdmissionApprovalSingleUse()public{reduceAndApprove();reg.setMarketActive(1,true);reg.setMarketMode(1,Registry.MarketMode.REDUCE_ONLY);vm.expectRevert(Registry.InvalidRecovery.selector);reg.setMarketActive(1,true);}
 function testAdmissionOracleChangeInvalidatesApproval()public{reduceAndApprove();address next=reg.createApprovedOracle(address(42),address(agg),keccak256('replacement'));reg.setOracle(1,next);require(!reg.recoveryApproved(1));vm.expectRevert(Registry.InvalidRecovery.selector);reg.setMarketActive(1,true);reg.setRecoveryApproved(1,true);reg.setMarketActive(1,true);}
 function testAdmissionOwnerChangeInvalidatesApprovalAndBinding()public{reduceAndApprove();reg.transferOwnership(B);vm.prank(B);reg.acceptOwnership();require(!reg.recoveryApproved(1)&&!engine.fundingProtectionReady());vm.prank(B);vm.expectRevert(Registry.InvalidRecovery.selector);reg.setMarketActive(1,true);rejectEntry();}
 function testAdmissionRepeatedEmergencySignalConsumesApproval()public{reduceAndApprove();reg.applyEmergencyTriggers(1,true,true,true);require(!reg.recoveryApproved(1)&&reg.marketMode(1)==Registry.MarketMode.REDUCE_ONLY);vm.expectRevert(Registry.InvalidRecovery.selector);reg.setMarketActive(1,true);}
 function testAdmissionActualResidualDebtBlocksRecovery()public{reg.setMarketMode(1,Registry.MarketMode.REDUCE_ONLY);vm.prank(address(engine));vault.coverBadDebt(address(t),1,0);vm.expectRevert(Registry.ResidualDebt.selector);reg.setRecoveryApproved(1,true);rejectEntry();}
 function testAdmissionGuardianCannotRestoreActive()public{reduceAndApprove();reg.setGuardian(B);vm.prank(B);vm.expectRevert(Registry.Forbidden.selector);reg.setEmergencyMarketMode(1,Registry.MarketMode.ACTIVE);vm.prank(B);reg.setEmergencyMarketMode(1,Registry.MarketMode.HALTED);vm.expectRevert(Registry.InvalidRecovery.selector);reg.setMarketActive(1,true);}
 function testAdmissionReferenceRemovalBlocksEntry()public{ctrl.clearCircuitBreaker(address(42));rejectEntry();}
 function testAdmission500PolicyChangeAndRestoreDoNotReviveOldApproval()public{reduceAndApprove();ctrl.setCircuitBreaker(address(42),address(r),501);ctrl.setCircuitBreaker(address(42),address(r),500);require(!reg.recoveryApproved(1));vm.expectRevert();reg.setMarketActive(1,true);rejectEntry();}
 function testAdmissionOracleErrorBlocksEntryAtomically()public{r.setBroken(true);rejectEntry();}
}
