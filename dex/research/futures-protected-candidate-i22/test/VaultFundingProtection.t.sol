pragma solidity ^0.8.24;
import {FinanceFixture,Engine,Vault,Registry} from './FinanceFixture.sol';
import {TestCollateral} from './EngineRegistryIntegration.t.sol';
import {FundingLedger} from '../src/funding/FundingLedger.sol';
import {InventorySlots} from './InventorySlots.sol';
interface VmGuard {function roll(uint256) external;function etch(address,bytes calldata) external;function mockCallRevert(address,bytes calldata,bytes calldata) external;function clearMockedCalls() external;function load(address,bytes32) external view returns(bytes32);function store(address,bytes32,bytes32) external;}
interface ITokenHook {function tokenHook() external;}
contract WithdrawalCallbackToken {
 mapping(address=>uint256) public balanceOf;mapping(address=>mapping(address=>uint256))public allowance;address public hook;
 function mint(address a,uint256 n)external{balanceOf[a]+=n;}function approve(address a,uint256 n)external returns(bool){allowance[msg.sender][a]=n;return true;}
 function arm(address target)external{hook=target;}
 function transferFrom(address from,address to,uint256 n)external returns(bool){allowance[from][msg.sender]-=n;balanceOf[from]-=n;balanceOf[to]+=n;return true;}
 function transfer(address to,uint256 n)external returns(bool){balanceOf[msg.sender]-=n;balanceOf[to]+=n;if(hook!=address(0))ITokenHook(hook).tokenHook();return true;}
}
contract VaultFundingProtectionTest is FinanceFixture {
 VmGuard constant vg=VmGuard(address(uint160(uint256(keccak256('hevm cheat code')))));
 FundingLedger ledger;WithdrawalCallbackToken cb;uint256 callbackMarket;uint256 callbackMode;bool callbackBlocked;
 function setUp()public override {super.setUp();vg.roll(100);ledger=FundingLedger(engine.createFundingLedger(10));engine.enableFundingWithdrawalProtection();}
 function knownDebt()internal {engine.configureFunding(1,RAY);_open(A,1,true,4000e18,5000e18);_withdraw(A,t,1000e18);engine.updateFundingIndex(1,4e25);_settle(A,1);_deposit(t,A,1000e18);require(vault.availableBalance(A,address(t))==1000e18&&ledger.accountPayable(A,address(t))==200e18);}
 function pendingDebt()internal {engine.configureFunding(1,RAY);_open(A,1,true,4000e18,5000e18);engine.updateFundingIndex(1,4e25);require(ledger.accountPayable(A,address(t))==0&&vault.availableBalance(A,address(t))==1000e18);}
 function snap()internal view returns(bytes32 h){h=keccak256(abi.encode(_snapshot(),ledger.totalPayable(address(t)),ledger.totalReceivable(address(t)),vault.otherReservedCollateral(A,address(t))));h=keccak256(abi.encode(h,engine.fundingActiveCount(A,address(t)),engine.fundingActiveSize(A,address(t)),engine.fundingMarketLength(A,address(t)),engine.fundingMarketCommitment(A,address(t)),engine.negativeRemainderHolds(A,address(t))));}
 function reject(uint256 n)internal{bytes32 before_=snap();vm.prank(A);vm.expectRevert(Vault.InsufficientUnencumberedCollateral.selector);vault.withdraw(address(t),n);require(snap()==before_);}
 function testGuardConfirmedDebtAllows800AndLeavesDebtIntact()public{knownDebt();require(vault.withdrawableBalance(A,address(t))==800e18);uint256 wallet=t.balanceOf(A);_withdraw(A,t,800e18);require(t.balanceOf(A)==wallet+800e18&&vault.availableBalance(A,address(t))==200e18&&ledger.accountPayable(A,address(t))==200e18);_assertBooks(t);}
 function testGuardConfirmedDebtRejects900And1000Atomically()public{knownDebt();reject(900e18);reject(1000e18);}
 function testGuardUncheckpointedDebtCannotBeWithdrawn()public{pendingDebt();require(engine.fundingWithdrawalRequirement(A,address(t))==200e18&&vault.withdrawableBalance(A,address(t))==800e18);reject(900e18);_withdraw(A,t,800e18);require(ledger.accountPayable(A,address(t))==0&&engine.previewFundingPayment(A,1)==-int256(200e18));_assertBooks(t);}
 function testGuardConfirmedAndPendingDebtCountedOnce()public{knownDebt();require(engine.previewFundingPayment(A,1)==0&&engine.fundingWithdrawalRequirement(A,address(t))==200e18);engine.updateFundingIndex(1,2e25);require(engine.fundingWithdrawalRequirement(A,address(t))==300e18&&vault.withdrawableBalance(A,address(t))==700e18);}
 function testGuardOtherReservationSubtractsAndCannotBeReused()public{knownDebt();vm.prank(A);engine.reserveOtherCollateral(address(t),bytes32('order1'),100e18);require(vault.withdrawableBalance(A,address(t))==700e18);vm.prank(A);vm.expectRevert(Vault.ReservationInvalid.selector);engine.reserveOtherCollateral(address(t),bytes32('order1'),1);vm.prank(A);vm.expectRevert(Vault.InsufficientUnencumberedCollateral.selector);engine.reserveOtherCollateral(address(t),bytes32('order2'),701e18);reject(800e18);vm.prank(A);engine.releaseOtherCollateral(address(t),bytes32('order1'));require(vault.withdrawableBalance(A,address(t))==800e18);vm.prank(A);vm.expectRevert(Vault.ReservationInvalid.selector);engine.releaseOtherCollateral(address(t),bytes32('order1'));}
 function testGuardSharedCollateralMarketsAggregateDebt()public{uint256 id=reg.addMarket(bytes32('same'),address(42),address(t),oracle,100000,500);_activate(id);engine.configureFunding(1,RAY);engine.configureFunding(id,RAY);_open(A,1,true,1000e18,5000e18);_open(A,id,true,1000e18,5000e18);engine.updateFundingIndex(1,2e25);engine.updateFundingIndex(id,4e25);require(engine.fundingWithdrawalRequirement(A,address(t))==300e18&&vault.withdrawableBalance(A,address(t))==2700e18&&engine.fundingMarketLength(A,address(t))==2);_assertBooks(t);}
 function testGuardDistinctCollateralDoesNotBorrowAnotherAssetsCash()public{pendingDebt();_open(A,2,true,1000e18,5000e18);require(vault.withdrawableBalance(A,address(u))==4000e18);_withdraw(A,u,4000e18);require(engine.fundingWithdrawalRequirement(A,address(t))==200e18);_assertBooks(t);_assertBooks(u);}
 function testGuardFractionIsOneBaseUnitNotDoubleHeld()public{_longAndShortFunding();engine.updateFundingIndex(1,100000);_settle(A,1);require(engine.negativeRemainderHolds(A,address(t))==1&&engine.fundingWithdrawalRequirement(A,address(t))==1&&vault.withdrawableBalance(A,address(t))==4000e18-1);engine.updateFundingIndex(1,100000);require(engine.fundingWithdrawalRequirement(A,address(t))==1);_settle(A,1);require(engine.fundingWithdrawalRequirement(A,address(t))==0&&vault.fundingPoolBalance(address(t))==1);}
 function testGuardClosedNegativeFractionRemainsReserved()public{_longAndShortFunding();engine.updateFundingIndex(1,100000);_close(A,1);require(engine.fundingMarketLength(A,address(t))==0&&engine.fundingActiveCount(A,address(t))==0&&engine.fundingWithdrawalRequirement(A,address(t))==1);_withdraw(A,t,5000e18-1);reject(1);require(engine.fundingRemainderRay(A,1,address(t))==-int256(5e26));_assertBooks(t);}
 function testGuardPositiveFractionIsNotWithdrawableMoney()public{_longAndShortFunding();engine.updateFundingIndex(1,100000);_settle(B,1);require(engine.fundingWithdrawalRequirement(B,address(t))==0&&vault.withdrawableBalance(B,address(t))==4000e18&&vault.fundingPoolBalance(address(t))==0);}
 function testGuardLockCollateralCannotSpendPendingFundingOrOtherHold()public{pendingDebt();uint256 id=reg.addMarket(bytes32('other'),address(42),address(t),oracle,100000,500);_activate(id);vm.prank(A);engine.reserveOtherCollateral(address(t),bytes32('order'),100e18);bytes32 before_=snap();vm.prank(A);vm.expectRevert(Vault.InsufficientUnencumberedCollateral.selector);engine.openPosition(id,800e18,800e18,true);require(snap()==before_);_open(A,id,true,700e18,700e18);require(vault.withdrawableBalance(A,address(t))==0);_assertBooks(t);}
 function testGuardRepaymentUsesFundingHoldButNotOtherReservation()public{knownDebt();vm.prank(A);engine.reserveOtherCollateral(address(t),bytes32('order'),100e18);_settle(A,1);require(ledger.accountPayable(A,address(t))==0&&vault.availableBalance(A,address(t))==800e18&&vault.otherReservedCollateral(A,address(t))==100e18&&vault.withdrawableBalance(A,address(t))==700e18&&vault.fundingPoolBalance(address(t))==200e18);_assertBooks(t);}
 function testGuardPartialRepaymentCannotConsumeOtherReservation()public{engine.configureFunding(1,RAY);_open(A,1,true,4000e18,5000e18);vm.prank(A);engine.reserveOtherCollateral(address(t),bytes32('order'),800e18);engine.updateFundingIndex(1,8e25);_settle(A,1);require(ledger.accountPayable(A,address(t))==200e18&&vault.availableBalance(A,address(t))==800e18&&vault.otherReservedCollateral(A,address(t))==800e18&&vault.withdrawableBalance(A,address(t))==0);_assertBooks(t);}
 function testGuardMissingMarketListFailsClosed()public{pendingDebt();bytes32 outer=keccak256(abi.encode(A,InventorySlots.ACTIVE_MARKETS));bytes32 slot=keccak256(abi.encode(address(t),outer));bytes32 original=vg.load(address(engine),slot);require(uint256(original)==1);vg.store(address(engine),slot,bytes32(0));bytes32 before_=snap();vm.prank(A);vm.expectRevert(Vault.FundingProtectionFailure.selector);vault.withdraw(address(t),1);require(snap()==before_);vg.store(address(engine),slot,original);require(vault.withdrawableBalance(A,address(t))==800e18);}
 function testGuardLedgerErrorFailsClosedWithoutStateChanges()public{knownDebt();bytes32 before_=snap();vg.mockCallRevert(address(ledger),abi.encodeWithSelector(bytes4(keccak256("accountPayable(address,address)"))),abi.encodeWithSignature('Error(string)','ledger unavailable'));vm.prank(A);vm.expectRevert(Vault.FundingProtectionFailure.selector);vault.withdraw(address(t),1);vg.clearMockedCalls();require(snap()==before_);}
 function testGuardEngineCodeMutationFailsClosed()public{pendingDebt();bytes memory code=address(engine).code;uint256 balance=vault.availableBalance(A,address(t));vg.etch(address(engine),hex'00');vm.prank(A);vm.expectRevert(Vault.FundingProtectionFailure.selector);vault.withdraw(address(t),1);vg.etch(address(engine),code);require(vault.availableBalance(A,address(t))==balance);}
 function testGuardCannotDisableByReplacingEngine()public{vm.expectRevert(Vault.ProtectionLocked.selector);vault.setEngine(address(77));require(vault.engine()==address(engine)&&vault.fundingWithdrawalProtection());}
 function testGuardStaleQuoteIsNotAuthorization()public{engine.configureFunding(1,RAY);_open(A,1,true,4000e18,5000e18);require(vault.withdrawableBalance(A,address(t))==1000e18);engine.updateFundingIndex(1,4e25);reject(1000e18);}
 function testGuardSerialTransactionsRevalidateIndex()public{engine.configureFunding(1,RAY);_open(A,1,true,4000e18,5000e18);_withdraw(A,t,500e18);engine.updateFundingIndex(1,4e25);reject(400e18);_withdraw(A,t,300e18);reject(1);_assertBooks(t);}
 function callbackSetup(uint256 mode)internal{cb=new WithdrawalCallbackToken();vault.setSupportedCollateral(address(cb),true);callbackMarket=reg.addMarket(bytes32('callback'),address(42),address(cb),oracle,100000,500);_activate(callbackMarket);_deposit(TestCollateral(address(cb)),A,2000e18);engine.configureFunding(callbackMarket,RAY);_open(A,callbackMarket,true,1000e18,5000e18);callbackMode=mode;cb.arm(address(this));}
 function tokenHook()external{require(msg.sender==address(cb));if(callbackMode==1){(bool ok,)=address(vault).call(abi.encodeWithSelector(Vault.withdraw.selector,address(cb),1));callbackBlocked=!ok;}else if(callbackMode==2)engine.updateFundingIndex(callbackMarket,4e25);}
 function testGuardTokenReentryCannotDoubleWithdraw()public{callbackSetup(1);uint256 wallet=cb.balanceOf(A);vm.prank(A);vault.withdraw(address(cb),800e18);require(callbackBlocked&&cb.balanceOf(A)==wallet+800e18&&vault.availableBalance(A,address(cb))==200e18);_assertBooks(TestCollateral(address(cb)));}
 function testGuardPostTransferRevalidationRejectsNewDebtAtomically()public{callbackSetup(2);uint256 wallet=cb.balanceOf(A);vm.prank(A);vm.expectRevert(Vault.InsufficientUnencumberedCollateral.selector);vault.withdraw(address(cb),900e18);(int256 index,,)=engine.fundingStates(callbackMarket);require(index==0&&cb.balanceOf(A)==wallet&&vault.availableBalance(A,address(cb))==1000e18);_assertBooks(TestCollateral(address(cb)));}
 function testGuardPostTransferRevalidationAllowsExactlyCoveredDebt()public{callbackSetup(2);vm.prank(A);vault.withdraw(address(cb),800e18);(int256 index,,)=engine.fundingStates(callbackMarket);require(index==4e25&&vault.availableBalance(A,address(cb))==200e18&&vault.withdrawableBalance(A,address(cb))==0);_assertBooks(TestCollateral(address(cb)));}
 function testGuardNormalCloseFeeAndReservationPreserved()public{knownDebt();vm.prank(A);engine.reserveOtherCollateral(address(t),bytes32('order'),100e18);engine.configureTradingFee(1,100,5000);_close(A,1);require(engine.fundingMarketLength(A,address(t))==0&&vault.availableBalance(A,address(t))==4750e18&&vault.otherReservedCollateral(A,address(t))==100e18&&vault.withdrawableBalance(A,address(t))==4650e18);_assertBooks(t);}
 function testGuardFeeCannotConsumeReservedCollateralAndCloseRollsBack()public{knownDebt();vm.prank(A);engine.reserveOtherCollateral(address(t),bytes32('order'),100e18);engine.configureTradingFee(1,9402,5000);bytes32 before_=snap();vm.prank(A);vm.expectRevert(Vault.InsufficientUnencumberedCollateral.selector);engine.closePosition(1);require(snap()==before_);}
 function testGuardNormalAdlUpdatesInventoryAndDoesNotCountReceivableAsCash()public{_debtForAdl(false);engine.configureFunding(1,RAY);engine.updateFundingIndex(1,DELTA);engine.configureAdlSafety(1,true,10000);engine.executeAdl(A,1,1250e18);require(engine.fundingActiveSize(A,address(t))==3750e18&&engine.fundingMarketLength(A,address(t))==1);engine.executeAdl(A,1,3750e18);require(engine.fundingActiveSize(A,address(t))==0&&engine.fundingMarketLength(A,address(t))==0&&vault.withdrawableBalance(A,address(t))==5000e18&&ledger.totalReceivable(address(t))==15e18);_assertBooks(t);}
 function testGuardLegacyLiquidationBypassRemainsRejected()public{vm.prank(address(engine));vm.expectRevert(Vault.ProtectedLiquidationNotIntegrated.selector);vault.settleLiquidationFunding(A,address(t),-1,1000e18,0);vm.expectRevert(Engine.LedgerLiquidationNotIntegrated.selector);engine.liquidate(A,1);}
 function testGuardActiveMarketLimitAndFailedOpenAreAtomic()public{_open(A,1,true,1e18,1e18);for(uint256 k;k<15;k++){uint256 id=reg.addMarket(bytes32(k+100),address(42),address(t),oracle,100000,500);_activate(id);_open(A,id,true,1e18,1e18);}require(engine.fundingMarketLength(A,address(t))==16);uint256 next=reg.addMarket(bytes32('over-limit'),address(42),address(t),oracle,100000,500);_activate(next);bytes32 before_=snap();vm.prank(A);vm.expectRevert(Engine.FundingInventoryInvalid.selector);engine.openPosition(next,1e18,1e18,true);require(snap()==before_&&vault.withdrawableBalance(A,address(t))==4984e18);_assertBooks(t);}
 function testGuardArithmeticFailureDoesNotAllowWithdrawal()public{_deposit(t,C,1e60);engine.configureFunding(1,RAY);_open(C,1,true,1e60,1e61);engine.updateFundingIndex(1,int256(RAY));uint256 balance=vault.availableBalance(C,address(t));vm.prank(C);vm.expectRevert(Vault.FundingProtectionFailure.selector);vault.withdraw(address(t),1);require(vault.availableBalance(C,address(t))==balance);_assertBooks(t);}
 function testFuzzGuardWithdrawBoundary(uint16 raw)public{knownDebt();uint256 amount=1+uint256(raw)%1000;uint256 before_=vault.availableBalance(A,address(t));vm.prank(A);if(amount>800){vm.expectRevert(Vault.InsufficientUnencumberedCollateral.selector);vault.withdraw(address(t),amount*1e18);require(vault.availableBalance(A,address(t))==before_);}else{vault.withdraw(address(t),amount*1e18);require(vault.availableBalance(A,address(t))==before_-amount*1e18&&ledger.accountPayable(A,address(t))==200e18);}_assertBooks(t);}
}
